<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OsclockSleepLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:fontFamily">@font/appbase_sf_pro_semibold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/osclock_gray</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="OsclockSleepTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/appbase_sf_pro_semibold</item>
        <item name="android:textColor">@color/osclock_text</item>
        <item name="android:textSize">28sp</item>
    </style>
</resources>
