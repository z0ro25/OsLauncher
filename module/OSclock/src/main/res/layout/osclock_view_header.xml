<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh đầu các tab: pill "Edit/Done" trái 16dp, nút tròn "+" 44dp phải, tiêu đề 34sp dưới. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/osclock_header_left"
        style="@style/OsclockGlassPill"
        android:layout_marginStart="16dp"
        android:minWidth="68dp"
        android:text="@string/osclock_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/osclock_header_right"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/osclock_bg_glass_circle"
        android:contentDescription="@string/osclock_add"
        android:scaleType="center"
        android:src="@drawable/osclock_ic_plus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/osclock_header_title"
        style="@style/OsclockTitle"
        android:layout_marginStart="16dp"
        android:layout_marginTop="52dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
