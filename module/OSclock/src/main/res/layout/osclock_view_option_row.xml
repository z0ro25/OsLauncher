<?xml version="1.0" encoding="utf-8"?>
<!-- Hàng tuỳ chọn 44dp trong thẻ #2c2c2e: tên trái, giá trị xám + chevron phải (hoặc toggle). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/osclock_opt_name"
        style="@style/OsclockBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/osclock_opt_value"
        style="@style/OsclockBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:gravity="end"
        android:textColor="@color/osclock_gray2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/osclock_opt_chevron"
        app:layout_constraintStart_toEndOf="@id/osclock_opt_name"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/osclock_opt_chevron"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/osclock_ic_chevron"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ezla.oslauncher.clock.ui.IosToggle
        android:id="@+id/osclock_opt_toggle"
        android:layout_width="52dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/osclock_opt_separator"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:background="@color/osclock_separator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
