<?xml version="1.0" encoding="utf-8"?>
<!-- Đầu sheet (Figma): grab 36x5, pill trái (Cancel) hoặc nút back tròn 40dp, tiêu đề giữa, pill phải. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp">

    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/osclock_bg_grab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/osclock_bar_left"
        style="@style/OsclockGlassPill"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:text="@string/osclock_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/osclock_bar_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/osclock_bg_glass_pill"
        android:contentDescription="@string/osclock_back"
        android:scaleType="center"
        android:src="@drawable/osclock_ic_back"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/osclock_bar_title"
        style="@style/OsclockSheetTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="96dp"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@id/osclock_bar_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/osclock_bar_left" />

    <TextView
        android:id="@+id/osclock_bar_right"
        style="@style/OsclockGlassPill.Bold"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        android:text="@string/osclock_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
