<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Stopwatch" (+ Running / Stopped / Analog). Vùng mặt số y 132..380 (so với dưới status bar)
     là ViewPager2 2 trang: số / analog. Nút tròn 88dp, chấm phân trang giữa 2 nút. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/osclock_sw_pager"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/osclock_sw_left"
        style="@style/OsclockRoundButton"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/osclock_sw_pager" />

    <TextView
        android:id="@+id/osclock_sw_right"
        style="@style/OsclockRoundButton"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/osclock_sw_left" />

    <LinearLayout
        android:id="@+id/osclock_sw_dots"
        android:layout_width="wrap_content"
        android:layout_height="8dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/osclock_sw_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/osclock_sw_dot0"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/osclock_bg_dot" />

        <View
            android:id="@+id/osclock_sw_dot1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/osclock_bg_dot" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/osclock_sw_laps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/osclock_list_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/osclock_sw_left" />
</androidx.constraintlayout.widget.ConstraintLayout>
