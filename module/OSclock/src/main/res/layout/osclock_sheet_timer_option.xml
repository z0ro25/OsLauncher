<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "When Timer Ends" (Cancel | tiêu đề | Set + danh sách chuông) và Label của hẹn giờ. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/osclock_bg_sheet"
    android:orientation="vertical">

    <include
        android:id="@+id/osclock_topt_bar"
        layout="@layout/osclock_view_sheet_bar" />

    <EditText
        android:id="@+id/osclock_topt_label"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/osclock_bg_card"
        android:fontFamily="@font/appbase_sf_pro_regular"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="40"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textColor="@color/osclock_text"
        android:textColorHint="@color/osclock_gray2"
        android:textCursorDrawable="@drawable/osclock_bg_caret"
        android:textSize="17sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/osclock_topt_sounds"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:layout_weight="1"
        android:background="@drawable/osclock_bg_card"
        android:clipToOutline="true"
        android:visibility="gone" />
</LinearLayout>
