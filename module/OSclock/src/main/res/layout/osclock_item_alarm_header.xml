<?xml version="1.0" encoding="utf-8"?>
<!-- Đầu danh sách Alarms (Figma y 160..300): "Sleep | Wake Up" + hàng lịch ngủ + "Other". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/OsclockSection"
        android:layout_marginStart="16dp"
        android:layout_marginTop="-4dp"
        android:text="@string/osclock_sleep_wake" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/osclock_sleep_summary"
            style="@style/OsclockBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:textColor="@color/osclock_gray" />

        <TextView
            android:id="@+id/osclock_sleep_change"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/osclock_bg_glass_small"
            android:fontFamily="@font/appbase_sf_pro_semibold"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingHorizontal="12dp"
            android:text="@string/osclock_change"
            android:textAllCaps="true"
            android:textColor="@color/osclock_orange"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:background="@color/osclock_separator" />

    <TextView
        android:id="@+id/osclock_other_title"
        style="@style/OsclockSection"
        android:layout_marginStart="16dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="8dp"
        android:text="@string/osclock_other" />
</LinearLayout>
