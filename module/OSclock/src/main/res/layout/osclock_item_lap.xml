<?xml version="1.0" encoding="utf-8"?>
<!-- Hàng lap 44dp: vạch trên, "Lap n" trái, thời gian phải (xanh = nhanh nhất, đỏ = chậm nhất). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/osclock_separator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/osclock_lap_name"
            style="@style/OsclockBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/osclock_lap_time"
            style="@style/OsclockBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>
</LinearLayout>
