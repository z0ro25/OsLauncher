<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Compass › Open in Maps": sheet kính trắng 344dp, cách mép 8dp, bo 34dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingBottom="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/compass_bg_sheet"
        android:paddingBottom="48dp">

        <View
            android:id="@+id/compass_sheet_grab"
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/compass_bg_grab"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Bấm tiêu đề = mở app bản đồ tại vị trí hiện tại. -->
        <LinearLayout
            android:id="@+id/compass_sheet_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/compass_sheet_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/appbase_sf_pro_bold"
                android:includeFontPadding="false"
                android:text="@string/compass_my_location"
                android:textColor="@color/compass_sheet_title"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/compass_sheet_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/appbase_sf_pro_regular"
                android:maxLines="2"
                android:textColor="@color/compass_sheet_subtitle"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/compass_sheet_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/compass_bg_close"
            android:contentDescription="@string/compass_close"
            android:padding="8dp"
            android:src="@drawable/compass_ic_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/compass_sheet_share"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="23dp"
            android:background="@drawable/compass_bg_share"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/compass_sheet_header">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/compass_ic_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/appbase_sf_pro_semibold"
                android:text="@string/compass_share_location"
                android:textColor="@color/compass_blue"
                android:textSize="17sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
