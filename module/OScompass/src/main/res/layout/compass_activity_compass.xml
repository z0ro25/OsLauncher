<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "13 · Compass" (frame 360x800, nền đen). Toạ độ y tính từ đỉnh frame (gồm status bar 48). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/compass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/compass_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.ezla.oslauncher.compass.CompassDialView
            android:id="@+id/compass_dial"
            android:layout_width="312dp"
            android:layout_height="312dp"
            android:layout_marginTop="184dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/compass_tv_heading"
            style="@style/CompassHeadingText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/compass_dial" />

        <!-- Khối thông tin bấm được: có vị trí -> sheet My Location, chưa có -> xin quyền. -->
        <LinearLayout
            android:id="@+id/compass_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/compass_tv_heading">

            <TextView
                android:id="@+id/compass_tv_coordinates"
                style="@style/CompassInfoText" />

            <TextView
                android:id="@+id/compass_tv_place"
                style="@style/CompassInfoText" />

            <TextView
                android:id="@+id/compass_tv_elevation"
                style="@style/CompassInfoText" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Figma "Compass › Calibrate": phủ đen toàn màn khi từ kế báo cần hiệu chỉnh. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/compass_calibrate_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/compass_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/compass_tv_calibrate_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:fontFamily="@font/appbase_sf_pro_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/compass_calibrate"
            android:textColor="@color/compass_text"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:fontFamily="@font/appbase_sf_pro_regular"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/compass_calibrate_hint"
            android:textColor="@color/compass_text_secondary"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/compass_tv_calibrate_title" />

        <com.ezla.oslauncher.compass.CalibrationRingView
            android:id="@+id/compass_ring"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="260dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/compass_tv_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/appbase_sf_pro_light"
            android:includeFontPadding="false"
            android:textColor="@color/compass_text"
            android:textSize="32sp"
            app:layout_constraintBottom_toBottomOf="@id/compass_ring"
            app:layout_constraintEnd_toEndOf="@id/compass_ring"
            app:layout_constraintStart_toStartOf="@id/compass_ring"
            app:layout_constraintTop_toTopOf="@id/compass_ring" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Figma "Compass › Location Permission": dim 25% + alert kính 280dp, 3 nút pill. -->
    <FrameLayout
        android:id="@+id/compass_permission_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/compass_dim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/compass_bg_alert"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:fontFamily="@font/appbase_sf_pro_semibold"
                android:gravity="center"
                android:text="@string/compass_permission_title"
                android:textColor="@color/compass_text"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/appbase_sf_pro_regular"
                android:gravity="center"
                android:text="@string/compass_permission_message"
                android:textColor="@color/compass_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/compass_btn_allow_while_using"
                style="@style/CompassAlertButton"
                android:layout_marginTop="16dp"
                android:background="@drawable/compass_bg_button_primary"
                android:text="@string/compass_allow_while_using" />

            <TextView
                android:id="@+id/compass_btn_allow_once"
                style="@style/CompassAlertButton"
                android:text="@string/compass_allow_once" />

            <TextView
                android:id="@+id/compass_btn_dont_allow"
                style="@style/CompassAlertButton"
                android:text="@string/compass_dont_allow" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
