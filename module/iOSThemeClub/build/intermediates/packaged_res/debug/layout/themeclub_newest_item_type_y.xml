<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/wallpaper_newest_big_itemX_height"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical">
           <ImageView
            android:id="@+id/y_img_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:src="@drawable/img_small"
            android:scaleType="centerCrop"/>
            <ImageView
            android:id="@+id/y_img_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:src="@drawable/img_small"
            android:layout_marginTop="@dimen/img_margin"/>
        </LinearLayout>
    <ImageView
        android:id="@+id/y_img_2"
        android:layout_width="0dp"
        android:layout_weight="2"
        android:layout_marginStart="@dimen/img_margin"
        android:layout_marginLeft="@dimen/img_margin"
        android:layout_height="@dimen/wallpaper_newest_big_itemX_height"
        android:scaleType="centerCrop"
        android:src="@drawable/img_big"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/wallpaper_newest_small_bottom_itemX_height"
        android:layout_marginTop="@dimen/img_margin"
        android:orientation="horizontal">
      <ImageView
        android:id="@+id/y_img_4"
        android:scaleType="centerCrop"
        android:src="@drawable/img_small"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"/>
       <ImageView
        android:id="@+id/y_img_5"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_small"
        android:layout_marginStart="@dimen/img_margin"
        android:layout_marginLeft="@dimen/img_margin"/>
       <ImageView
        android:id="@+id/y_img_6"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/img_margin"
        android:layout_marginLeft="@dimen/img_margin"
        android:scaleType="centerCrop"
        android:src="@drawable/img_small"/>
    </LinearLayout>

</LinearLayout>