<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">
    <include
        android:id="@+id/top_title"
        layout="@layout/themeclub_detail_title"/>
    <ScrollView
        android:id="@+id/ScroolView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_install"
        android:layout_below="@+id/top_title">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFFFF">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lock_particular_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none"/>
                <include
                    layout="@layout/themeclub_item_sources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/lock_particular_info"
                    android:layout_marginBottom="4dp"
                    android:layout_marginTop="20dp"/>
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F7F7F7"
                android:orientation="vertical">
                <include
                    layout="@layout/themeclub_more_lock_screen"/>
                <include
                    layout="@layout/themeclub_more_wallpapers"/>
                <include
                    layout="@layout/themeclub_more_themes"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/bottom_install"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:background="#F7F7F7">
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"/>

        <Button
            android:id="@+id/download_lock"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/themeclub_download_button"
            android:gravity="center"
            android:text="@string/themeclub_download_theme"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <com.amz.ios.themeclub.view.TextProgressBar
            android:id="@+id/lock_progressbar_id"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="#FFFFFF"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/themeclub_download_progress"
            android:visibility="gone">
        </com.amz.ios.themeclub.view.TextProgressBar>
    </RelativeLayout>
</RelativeLayout>
