<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="@dimen/themeclub_tab_height"
                android:background="@color/themeclub_common_title_bar_color"
                android:elevation="3dip"
                android:orientation="vertical"
                android:paddingEnd="6dp"
                android:paddingLeft="16dp"
                android:paddingRight="6dp"
                android:paddingStart="16dp">

        <ImageView
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:src="@drawable/source_detail_back"/>
        <com.amz.ios.launcher.views.CustomTextView
            android:id="@+id/theme_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:layout_centerInParent="true"/>

        <ImageView
            android:id="@+id/share_detail"
            android:layout_width="44dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_height="44dp"
            android:scaleType="center"
            android:layout_centerVertical="true"
            android:src="@drawable/normal_share"/>


</RelativeLayout>