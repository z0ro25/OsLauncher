<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/set_wallpaper_toolbar"
        android:minHeight="?attr/actionBarSize"
        android:layout_width="match_parent"
        android:layout_height="@dimen/themeclub_tab_height"
        android:elevation="3dip"
        android:background="#ffffff">
    </androidx.appcompat.widget.Toolbar>

    <Button
        android:id="@+id/set_as_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/themeclub_wallpaper_set_selctor"
        android:textColor="@android:color/white"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:textSize="15sp"
        android:elevation="2dp"
        android:text="@string/themeclub_set_as_wallpaper"/>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/image_viewpager"
        android:layout_below="@id/set_wallpaper_toolbar"
        android:layout_above="@id/set_as_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        layout="@layout/themeclub_setwallpaper_waiting"/>

</RelativeLayout>
