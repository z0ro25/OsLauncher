<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ios="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/progress"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

        <com.amz.ios.ioslite.common.view.IOSLoadingView
            android:id="@+id/iosloadingView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            ios:minHeight="30dp"
            ios:minWidth="30dp"
            ios:maxWidth="50dp"
            ios:maxHeight="50dp"
            ios:indicatorType="1"
            android:layout_centerInParent="true"
            ios:indicatorColor="@color/themeclub_loading_color"/>
        <com.amz.ios.launcher.views.CustomTextView
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_below="@id/iosloadingView"
            android:layout_centerInParent="true"
            android:textSize="@dimen/loading_size"
            android:textColor="@color/themeclub_loading_color"
            android:text="@string/themeclub_loading"/>
        <com.amz.ios.launcher.views.CustomTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/loading"
            android:text="@string/three_point"
            android:layout_toRightOf="@id/loading"
            android:layout_alignBottom="@id/loading"/>

</RelativeLayout>