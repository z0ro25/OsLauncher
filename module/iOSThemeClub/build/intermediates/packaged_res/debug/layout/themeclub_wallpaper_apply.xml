<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/delete_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#c4000000"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/themeclub_crop_text_color_pressed">
        <com.amz.ios.launcher.views.CustomTextView
            android:id="@+id/apply_launch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/apply_wallpaper_height"
            android:gravity="center"
            android:text="@string/themeclub_apply_launch"
            android:textSize="@dimen/apply_ok_size"
            android:textColor="@color/ok_delete_color"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F7F7F7"/>
        <com.amz.ios.launcher.views.CustomTextView
            android:id="@+id/apply_lockscreen"
            android:layout_width="match_parent"
            android:layout_height="@dimen/apply_wallpaper_height"
            android:gravity="center"
            android:text="@string/themeclub_apply_lockscreen"
            android:textSize="@dimen/apply_ok_size"
            android:textColor="@color/ok_delete_color"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F7F7F7"/>
        <com.amz.ios.launcher.views.CustomTextView
            android:id="@+id/apply_all"
            android:layout_width="match_parent"
            android:layout_height="@dimen/apply_wallpaper_height"
            android:gravity="center"
            android:text="@string/themeclub_apply_all"
            android:textSize="@dimen/apply_ok_size"
            android:textColor="@color/ok_delete_color"/>

    </LinearLayout>
</LinearLayout>
