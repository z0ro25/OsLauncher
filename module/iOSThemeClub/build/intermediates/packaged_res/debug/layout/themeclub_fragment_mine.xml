<?xml version="1.0" encoding="utf-8"?>
<com.amz.ios.themeclub.view.TouchCallbackLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <androidx.viewpager.widget.ViewPager
        android:layout_marginTop="@dimen/tabs_height"
        android:background="@color/themeclub_mine_viewpage_bg"
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/heard"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:background="@color/themeclub_accent_color"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/login_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/viewpager_header_height">
            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/login_or_user_icon"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="30dp"
                android:src="@drawable/ic_login_default"/>
            <!--<ImageButton-->
                <!--android:id="@+id/login_or_user_icon"-->
                <!--android:background="@android:color/transparent"-->
                <!--android:layout_width="wrap_content"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:layout_centerInParent="true"-->
                <!--android:src="@drawable/themeclub_login_icon"/>-->
            <com.amz.ios.launcher.views.CustomTextView
                android:id="@+id/login_or_user_name"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textSize="16sp"
                android:layout_below="@id/login_or_user_icon"
                android:textColor="@android:color/white"
                android:layout_centerHorizontal="true"
                android:text="@string/themeclub_login"/>
        </RelativeLayout>
        <com.amz.ios.themeclub.view.SlidingTabLayout
            android:id="@+id/tabs"
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <include
        layout="@layout/themeclub_setwallpaper_waiting"/>

</com.amz.ios.themeclub.view.TouchCallbackLayout>