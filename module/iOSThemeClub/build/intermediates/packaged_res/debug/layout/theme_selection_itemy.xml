<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/theme_selection_y_1"
        android:scaleType="centerCrop"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="@dimen/theme_selection_height_y" />
    <ImageView
        android:id="@+id/theme_selection_y_2"
        android:scaleType="centerCrop"
        android:layout_marginLeft="@dimen/img_margin"
        android:layout_marginRight="@dimen/img_margin"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="@dimen/theme_selection_height_y" />
    <ImageView
        android:id="@+id/theme_selection_y_3"
        android:scaleType="centerCrop"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="@dimen/theme_selection_height_y" />

</LinearLayout>