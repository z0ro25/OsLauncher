<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <RelativeLayout
        android:layout_margin="2dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/themeclub_theme_preview_height"
        >
        <ImageView
            android:id="@+id/preview"
            android:contentDescription="@string/app_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/themeclub_theme_preview_height"
            android:src="@drawable/font_theme_bg"
            android:scaleType="centerCrop"
            />
        <RelativeLayout
            android:id="@+id/selected"
            android:visibility="gone"
            android:background="#55000000"
            android:layout_centerInParent="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/themeclub_theme_preview_height">
            <ImageView
                android:src="@drawable/naike"
                android:layout_centerInParent="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </RelativeLayout>

        <com.amz.ios.launcher.views.CustomTextView
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:id="@+id/theme_title"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:background="@color/themeclub_theme_item_text_background"
            android:gravity="center"
            android:text="@string/themeclub_default_thmem"
            android:textColor="@android:color/white"
            android:padding="5dp"
            />
    </RelativeLayout>
</RelativeLayout>
