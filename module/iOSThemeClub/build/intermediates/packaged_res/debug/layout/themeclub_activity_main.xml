<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.amz.ios.themeclub.MainActivity">


    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:elevation="5dip"
        android:background="@color/bootom_tablayout_bg"
        app:tabTextAppearance="@style/BottomTabLayoutTextAppearance">
    </com.google.android.material.tabs.TabLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/tab"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    </androidx.viewpager.widget.ViewPager>

    <com.amz.ios.launcher.views.CustomTextView
        android:id="@+id/theme_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/themeclub_accent_color"
        android:gravity="center"
        android:text="@string/themeclub_app_name"
        android:textColor="@color/white"
        android:textSize="18sp" />
</RelativeLayout>
