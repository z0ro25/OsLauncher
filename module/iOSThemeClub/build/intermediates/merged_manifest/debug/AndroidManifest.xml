        <!-- android:label="@string/themeclub_app_name" -->
        <!-- android:name=".PackageBroadcastReceiver"> -->
        <!-- <intent-filter> -->
        <!-- <action android:name="android.intent.action.PACKAGE_ADDED" /> -->
        <!-- <action android:name="android.intent.action.PACKAGE_REPLACED" /> -->
        <!-- <action android:name="android.intent.action.PACKAGE_REMOVED" /> -->
        <!-- <data android:scheme="package" /> -->
        <!-- </intent-filter> -->
        <!-- </receiver> -->

        <provider
            android:name="com.amz.ios.themeclub.dao.ThemeContentProvide"
            android:authorities="com.amz.ios.themeclub.provide"
            android:exported="true" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.amz.ios.themeclub.file.provider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/themeclub_apk_paths" />
        </provider>

        <activity
            android:name="com.amz.ios.themeclub.ui.activity.OnlineWallpapersDetailActivity"
            android:exported="true"
            android:theme="@style/AppThemeDetailLocal" />

        <receiver
            android:name="com.amz.ios.themeclub.DownloadReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>