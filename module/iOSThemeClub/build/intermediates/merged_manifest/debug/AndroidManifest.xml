<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.amz.ios.themeclub" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />
    <!-- <uses-permission android:name="android.permission.INTERNET" /> -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS" -->
    <!-- tools:ignore="ProtectedPermissions" /> -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_MEDIA_STORAGE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.ACCESS_DOWNLOAD_MANAGER" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:supportsRtl="true" >
        <activity
            android:name="com.amz.ios.themeclub.MainActivity"
            android:autoRemoveFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:icon="@drawable/ic_app_theme"
            android:label="@string/themeclub_app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeDetail" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="ios.intent.action.ThemeClubActivity" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.OnlineThemeDetailActivity"
            android:exported="true"
            android:label="@string/themeclub_app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeDetail" >
        </activity>
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.LockScreenDetailActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeDetail" >
        </activity>
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.OnlineWallpaperDetailActivity"
            android:exported="true"
            android:label="@string/themeclub_app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeDetailLocal" />
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.ShowDownloadedWallpaperActivity"
            android:exported="true"
            android:label="@string/themeclub_app_name"
            android:resizeableActivity="false"
            android:theme="@style/themeclub.setwallpaper.style" />
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.LocalThemeDetailActivity"
            android:exported="true"
            android:label="@string/themeclub_app_name"
            android:launchMode="singleInstance"
            android:resizeableActivity="false"
            android:theme="@style/AppThemeDetailLocal" />
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.LocalLockScreenDetailActivity"
            android:exported="true"
            android:label="@string/themeclub_app_name"
            android:launchMode="singleInstance"
            android:resizeableActivity="false"
            android:theme="@style/AppThemeDetail" />
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.WallPaperSelectionSpecialActivity"
            android:exported="true"
            android:label="@string/themeclub_app_name"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeDetail" />
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.SourceDetailActivity"
            android:exported="true"
            android:label="@string/themeclub_app_name"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name="com.theartofdev.edmodo.cropper.CropImageActivity"
            android:exported="true"
            android:label="@string/themeclub_app_name"
            android:resizeableActivity="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.FontDetailActivity"
            android:exported="true"
            android:theme="@style/AppThemeDetailLocal" />
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.FullThemeActivity"
            android:exported="true"
            android:theme="@style/AppThemeFullTheme" />
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.CropImageActivity"
            android:exported="true"
            android:label="@string/themeclub_app_name"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeWallpaperCrop" />
        <activity
            android:name="com.amz.ios.themeclub.ui.activity.ThemeSelectionSpecialActivity"
            android:exported="true"
            android:label="@string/themeclub_app_name"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/AppThemeDetail" />
        <!-- <receiver android:name="com.amz.ios.themeclub.ui.activity.OnlineThemeDetailActivity$InstallReceiver"> -->
        <!-- <intent-filter> -->
        <!-- <action android:name="android.intent.action.PACKAGE_ADDED"/> -->
        <!-- </intent-filter> -->
        <!-- </receiver> -->
