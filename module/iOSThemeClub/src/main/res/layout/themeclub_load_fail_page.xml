<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ios="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone"
    android:gravity="center"
    android:id="@+id/no_net">
    <com.amz.ios.ioslite.common.view.IOSLoadingView
        android:id="@+id/no_net_click_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        ios:indicatorType="2"/>

        <com.amz.ios.launcher.views.CustomTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/retry_size"
            android:textColor="@color/themeclub_loading_color"
            android:layout_marginTop="@dimen/retry_margin_top"
            android:text="@string/themeclub_retry"/>
</LinearLayout>