<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/temp_view"
        android:background="@color/themeclub_accent_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/theme_special_toolbar"
        android:background="@color/themeclub_accent_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tool_bar_height">
        <com.amz.ios.launcher.views.CustomTextView
            android:id="@+id/theme_special_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="18sp"
            android:textColor="#ffffff"/>
        </androidx.appcompat.widget.Toolbar>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/theme_special_recycle"
            android:layout_marginTop="@dimen/theme_margin"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
</LinearLayout>