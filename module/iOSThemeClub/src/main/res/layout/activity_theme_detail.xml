<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.LocalThemeDetailActivity"
    android:background="#F7F7F7">

    <include
        android:id="@+id/top_title"
        layout="@layout/themeclub_local_detail_title"/>

    <RelativeLayout
        android:id="@+id/particular_relative"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top_title"
        android:background="#FFFFFF">

        <RelativeLayout
            android:id="@+id/particular_framelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/layout_info"
            android:layout_marginBottom="0dp"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <com.amz.ios.themeclub.view.ThemePagedView
                android:id="@+id/theme_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/indicator"
                android:layout_marginBottom="0dp"
                launcher:defaultScreen="0"
                launcher:pageIndicator="@+id/indicator" />

            <include
                android:id="@+id/indicator"
                layout="@layout/theme_page_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center_horizontal" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/layout_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="24dp"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <com.amz.ios.launcher.views.CustomTextView
                    android:id="@+id/name_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:textColor="#DE000000"
                    android:textSize="14sp" />

                <com.amz.ios.launcher.views.CustomTextView
                    android:id="@+id/introduce_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_below="@+id/name_detail"
                    android:ellipsize="end"
                    android:textColor="#8A000000"
                    android:textSize="13sp"></com.amz.ios.launcher.views.CustomTextView>

            </LinearLayout>


            <com.amz.ios.launcher.views.CustomTextView
                android:id="@+id/apply_theme"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_gravity="top"
                android:layout_marginEnd="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#1B9CD8"
                android:gravity="center"
                android:text="@string/themeclub_apply"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <include
        layout="@layout/themeclub_setwallpaper_waiting"/>

    <RelativeLayout
        android:id="@+id/full_theme_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:background="@color/transparent">

        <com.amz.ios.themeclub.view.ThemePagedView
            android:id="@+id/full_theme_pagedview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </RelativeLayout>

</RelativeLayout>
