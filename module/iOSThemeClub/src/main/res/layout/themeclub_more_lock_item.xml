<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/menu_theme_img"
        android:layout_width="107dp"
        android:layout_height="187dp"
        android:background="@drawable/theme_no_default2"/>
    <ImageView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignRight="@id/menu_theme_img"
        android:layout_alignTop="@id/menu_theme_img"
        android:visibility="gone"
        android:layout_marginTop="11dp"
        android:layout_marginRight="1dp"
        android:background="@drawable/status_downloaded" />
    <com.amz.ios.launcher.views.CustomTextView
        android:id="@+id/menu_theme_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="#3f3f3f"
        android:layout_below="@id/menu_theme_img"
        android:layout_centerInParent="true"/>

</RelativeLayout>
