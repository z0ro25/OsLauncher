<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="themeclubLockscreenItemView">
        <attr name="themeclubDataSize" format="integer"/>
        <attr name="themeclubChildHeight" format="dimension"/>
        <attr name="themeclubLeftMargin" format="dimension"/>
        <attr name="themeclubTopMargin" format="dimension"/>
        <attr name="themeclubChildRightMargin" format="dimension"/>
        <attr name="themeclubParentViewMargin" format="dimension"/>
    </declare-styleable>

    <!--<declare-styleable name="PageIndicator">-->
        <!--<attr name="windowSize" format="integer" />-->
    <!--</declare-styleable>-->

    <!--<declare-styleable name="PagedView">-->
        <!--&lt;!&ndash; A spacing override for the icons within a page &ndash;&gt;-->
        <!--<attr name="pageLayoutWidthGap" format="dimension" />-->
        <!--<attr name="pageLayoutHeightGap" format="dimension" />-->

        <!--&lt;!&ndash; The page indicator for this workspace &ndash;&gt;-->
        <!--<attr name="pageIndicator" format="reference" />-->
    <!--</declare-styleable>-->

    <declare-styleable name="PageView">
        <!-- The first screen the workspace should display. -->
        <attr name="defaultScreen" format="integer" />
        <!-- The number of horizontal cells in the CellLayout -->
        <attr name="cellCountX" format="integer" />
        <!-- The number of vertical cells in the CellLayout -->
        <attr name="cellCountY" format="integer" />
    </declare-styleable>

    <declare-styleable name="ImageCoverFlowView">
        <attr name="visibleImage" format="integer" />
        <attr name="reflectionHeight" format="fraction" />
        <attr name="reflectionGap" format="dimension" />
        <attr name="topImageClickEnable" format="boolean" />
        <attr name="coverflowGravity" format="enum">
            <enum name="top" value="0" />
            <enum name="bottom" value="1" />
            <enum name="center_vertical" value="2" />
        </attr>
        <attr name="coverflowLayoutMode" format="enum">
            <enum name="match_parent" value="0"></enum>
            <enum name="wrap_content" value="1"></enum>
        </attr>
    </declare-styleable>
</resources>