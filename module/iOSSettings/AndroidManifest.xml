    <application
        android:allowBackup="true">
        <activity
            android:exported="true"
            android:resizeableActivity="false"
            android:name="com.amz.ios.iossettings.SettingsActivity"
            android:screenOrientation="portrait"
            android:anyDensity="true"
            android:icon="@drawable/settings_ic"
            android:label="@string/settings_app_name"
            android:launchMode="singleTask"
            android:taskAffinity="com.ios.iossettings"
            android:normalScreens="true"
            android:smallScreens="true"
            android:theme="@style/SettingsAppTheme">
            <!--
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            -->

            <intent-filter>
                <action android:name="com.ios.ioslite.CREATE_SHORTCUT" />
            </intent-filter>
        </activity>

        <receiver
            android:exported="true"
            android:name="com.amz.ios.iossettings.TorchWidgetProvider"
            android:label="@string/torch_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.IOS_WIDGET" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/torch_widget_info" />
        </receiver>
    </application>

