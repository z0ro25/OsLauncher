<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/all_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@color/transparent"
    android:fillViewport="true">


    <!--search head block-->
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        />
    <com.github.mmin18.widget.RealtimeBlurView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:realtimeBlurRadius="15dp"
        app:realtimeOverlayColor="@color/transparent"
        app:realtimeDownsampleFactor="8"
        />

    <include
        android:id="@+id/search_head"
        layout="@layout/fmsearch_layout_search_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/fmsearch_dp_item_outer_common_padding"
        android:layout_marginRight="@dimen/fmsearch_dp_item_outer_common_padding"
        android:layout_marginStart="@dimen/fmsearch_dp_item_outer_common_padding"
        android:layout_marginEnd="@dimen/fmsearch_dp_item_outer_common_padding"
        android:layout_marginTop="@dimen/fmsearch_dp_item_outer_common_padding" />

    <!-- content -->
    <RelativeLayout
        android:id="@+id/seperator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/search_head"
        android:background="@color/white"
        android:visibility="gone">

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/search_head">

        <!--content webView-->
        <ViewStub
            android:id="@+id/web_container"
            android:layout="@layout/fmsearch_layout_search_webcontent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/fmsearch_dp_item_haf_inner_common_padding"
            android:layout_marginLeft="@dimen/fmsearch_dp_item_inner_common_padding"
            android:layout_marginRight="@dimen/fmsearch_dp_item_inner_common_padding"
            android:layout_marginStart="@dimen/fmsearch_dp_item_inner_common_padding"
            android:layout_marginEnd="@dimen/fmsearch_dp_item_inner_common_padding" />

        <!--search adapterview content-->
        <include layout="@layout/fmsearch_layout_search_content" />

    </FrameLayout>

</RelativeLayout>