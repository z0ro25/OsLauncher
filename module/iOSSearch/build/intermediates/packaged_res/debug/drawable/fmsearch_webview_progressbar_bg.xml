<?xml version="1.0" encoding="UTF-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="1.0dip" />
            <background android:color="#ff000000" />
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="1.0dip" />

                <gradient
                    android:angle="270.0"
                    android:centerColor="#9999ff"
                    android:centerY="0.75"
                    android:endColor="#aaafff"
                    android:startColor="#5555ff" />

                <stroke
                    android:width="0.2dip"
                    android:color="#B7B9D1" />
            </shape>
        </clip>
    </item>

</layer-list>