        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>
    <declare-styleable name="MaskImageView">

        <attr format="enum" name="mask_level">
            <enum name="background" value="1"/>
            <enum name="foreground" value="2"/>
        </attr>
        
        <attr format="boolean" name="is_show_mask_on_click"/>
        <attr format="color" name="mask_color"/>
        
        <attr format="boolean" name="is_ignore_alpha"/>

    </declare-styleable>
    <declare-styleable name="TagFlowLayout">
        <attr format="boolean" name="auto_select_effect"/>
        <attr format="integer" name="max_select"/>
        <attr name="gravity">
