<?xml version="1.0" encoding="utf-8"?>
<com.amz.ios.search.MerlinCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:cardElevation="@dimen/fmsearch_dp_cardelevation">

    <!--changed by Hong-->
    <RelativeLayout
        android:id="@+id/real_search_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fmsearch_dp_item_search_content_height"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <RelativeLayout
            android:id="@+id/input_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:layout_marginLeft="@dimen/fmsearch_dp_item_inner_common_padding"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_real_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:src="@mipmap/ic_search_default" />

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/fmsearch_dp_item_outer_common_padding"
                android:layout_marginRight="@dimen/fmsearch_dp_item_outer_common_padding"
                android:layout_marginStart="@dimen/fmsearch_dp_item_inner_common_padding"
                android:layout_toLeftOf="@+id/btn_cancel"
                android:layout_toRightOf="@id/btn_real_search"
                android:background="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical|start"
                android:imeOptions="actionNone"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/fmsearch_white"
                android:textCursorDrawable="@drawable/fmsearch_dw_input_cusor"
                android:textSize="@dimen/fmsearch_sp_search_head_txt">

                <requestFocus />
            </EditText>


            <ImageView
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:padding="@dimen/fmsearch_dp_item_inner_common_padding"
                android:src="@mipmap/ic_cancel"
                android:visibility="gone" />
        </RelativeLayout>

    </RelativeLayout>

    <com.amz.ios.launcher.views.CustomTextView
        android:id="@+id/btn_search_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fmsearch_dp_item_search_content_height"
        android:background="@null"
        android:gravity="center_vertical"
        android:paddingEnd="@dimen/fmsearch_dp_item_outer_common_padding"
        android:paddingLeft="@dimen/fmsearch_dp_item_outer_common_padding"
        android:paddingRight="@dimen/fmsearch_dp_item_outer_common_padding"
        android:paddingStart="@dimen/fmsearch_dp_item_outer_common_padding"
        android:textSize="@dimen/fmsearch_sp_search_head_txt"
        android:visibility="gone"
        android:textColor="@color/white"/>

    <com.amz.ios.search.widget.MerlinFlashProgressBar
        android:id="@+id/progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#ffff00"
        android:progressDrawable="@drawable/fmsearch_webview_progressbar_bg"
        android:visibility="gone" />

</com.amz.ios.search.MerlinCardView>