<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4: minWidth 320dp (-> span 4), minHeight 320dp (-> span 4).
     Cả hai PHẢI là @dimen (không literal) để fromIOSWidgetComponent không ném NotFoundException. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="@dimen/calendar_upnext_min_width"
    android:minHeight="@dimen/calendar_upnext_large_min_height"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/calendar_upnext_large_widget"
    android:previewImage="@drawable/sample_calendar_widget"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    />
