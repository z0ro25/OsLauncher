<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Lịch LƯỚI THÁNG (đủ ngày) cho màn trang trái (Today), cỡ 2x2.
  CalendarMiniMonthView tự vẽ thẻ trắng + lưới ngày (không cần quyền/dữ liệu, tự làm mới),
  ép tỉ lệ 1:1 cho vuông; kèm badge xoá dùng chung khi vào chế độ edit (rung).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:animateLayoutChanges="true">

    <com.amz.ios.launcher.widget.view.CalendarMiniMonthView
        android:id="@+id/calendar_month_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="w, 1:1"/>

    <com.amz.ios.launcher.leftpage.custom.CustomZoomImageView
        android:id="@+id/icon_delete_widget"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="@dimen/icon_delete_size"
        android:layout_height="@dimen/icon_delete_size"
        android:src="@drawable/delete_button"
        android:antialias="true"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
