<?xml version="1.0" encoding="utf-8"?>
<!-- World Clock ngang (span 4x2): thẻ TỐI, 4 cột New York / London / Dubai / Sydney.
     Mỗi cột: mặt số (có số + kim giây cam, tự đổi ngày/đêm theo giờ địa phương) +
     tên tp (trắng đậm) + Today/Tomorrow (xám) + chênh lệch giờ (cam).
     Múi giờ & nhãn động khai báo trực tiếp qua custom attrs, không cần code bind. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Nền KÍNH MỜ (blur wallpaper); fallback thẻ TỐI theo theme khi máy không hỗ trợ blur. -->
    <com.amz.ios.launcher.widget.view.GlassBlurView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:gbvCornerRadius="@dimen/widget_round_corner"
        app:gbvBorderColor="#40FFFFFF"
        app:gbvBorderWidth="1dp"
        app:gbvOverlayColor="#73000000"
        app:gbvFallbackDrawable="@drawable/widget_clock_card_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="12dp"
        android:weightSum="4">

    <!-- City 1: New York -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <com.amz.ios.launcher.widget.view.AnalogClockView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:acvShowNumbers="true"
            app:acvShowSecond="true"
            app:acvTimeZone="America/New_York" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="New York"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.amz.ios.launcher.widget.view.WorldClockTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8E8E93"
            android:textSize="9sp"
            app:wctvMode="day"
            app:wctvTimeZone="America/New_York" />

        <com.amz.ios.launcher.widget.view.WorldClockTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFF6D00"
            android:textSize="9sp"
            app:wctvMode="diff"
            app:wctvTimeZone="America/New_York" />
    </LinearLayout>

    <!-- City 2: London -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <com.amz.ios.launcher.widget.view.AnalogClockView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:acvShowNumbers="true"
            app:acvShowSecond="true"
            app:acvTimeZone="Europe/London" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="London"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.amz.ios.launcher.widget.view.WorldClockTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8E8E93"
            android:textSize="9sp"
            app:wctvMode="day"
            app:wctvTimeZone="Europe/London" />

        <com.amz.ios.launcher.widget.view.WorldClockTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFF6D00"
            android:textSize="9sp"
            app:wctvMode="diff"
            app:wctvTimeZone="Europe/London" />
    </LinearLayout>

    <!-- City 3: Dubai -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <com.amz.ios.launcher.widget.view.AnalogClockView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:acvShowNumbers="true"
            app:acvShowSecond="true"
            app:acvTimeZone="Asia/Dubai" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Dubai"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.amz.ios.launcher.widget.view.WorldClockTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8E8E93"
            android:textSize="9sp"
            app:wctvMode="day"
            app:wctvTimeZone="Asia/Dubai" />

        <com.amz.ios.launcher.widget.view.WorldClockTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFF6D00"
            android:textSize="9sp"
            app:wctvMode="diff"
            app:wctvTimeZone="Asia/Dubai" />
    </LinearLayout>

    <!-- City 4: Sydney -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <com.amz.ios.launcher.widget.view.AnalogClockView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:acvShowNumbers="true"
            app:acvShowSecond="true"
            app:acvTimeZone="Australia/Sydney" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sydney"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.amz.ios.launcher.widget.view.WorldClockTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8E8E93"
            android:textSize="9sp"
            app:wctvMode="day"
            app:wctvTimeZone="Australia/Sydney" />

        <com.amz.ios.launcher.widget.view.WorldClockTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFF6D00"
            android:textSize="9sp"
            app:wctvMode="diff"
            app:wctvTimeZone="Australia/Sydney" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
