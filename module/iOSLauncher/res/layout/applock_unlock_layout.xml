<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/applock_unlock_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical" >

    <TextView
        android:id="@+id/applock_unlock_state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:textColor="@color/colorblack"
        android:textSize="19dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal" >

            <ImageView
                android:id="@+id/applock_unlock_pws_one"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/applock_num_normal" />

            <ImageView
                android:id="@+id/applock_unlock_pws_two"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:src="@drawable/applock_num_normal" />

            <ImageView
                android:id="@+id/applock_unlock_pws_three"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:src="@drawable/applock_num_normal" />

            <ImageView
                android:id="@+id/applock_unlock_pws_four"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:src="@drawable/applock_num_normal" />

            <ImageView
                android:id="@+id/applock_unlock_pws_five"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:src="@drawable/applock_num_normal" />

            <ImageView
                android:id="@+id/applock_unlock_pws_six"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:src="@drawable/applock_num_normal" />
        </LinearLayout>

        <ImageView
            android:id="@+id/applock_unlock_pws_clean"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="70dp"
            android:src="@drawable/applock_numclean"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/applock_keyboard_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:paddingLeft="50dp"
        android:paddingRight="50dp" >

        <ImageView
            android:id="@+id/applock_keyboard_numone"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:src="@drawable/applock_num1"
            android:tag="@string/one" />

        <ImageView
            android:id="@+id/applock_keyboard_numtwo"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="1.0dp"
            android:layout_weight="1"
            android:src="@drawable/applock_num2"
            android:tag="@string/two" />

        <ImageView
            android:id="@+id/applock_keyboard_numthree"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="1.0dp"
            android:layout_weight="1"
            android:src="@drawable/applock_num3"
            android:tag="@string/three" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/applock_keyboard_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:paddingLeft="50dp"
        android:paddingRight="50dp" >

        <ImageView
            android:id="@+id/applock_keyboard_numfour"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:src="@drawable/applock_num4"
            android:tag="@string/four" />

        <ImageView
            android:id="@+id/applock_keyboard_numfive"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="1.0dp"
            android:layout_weight="1"
            android:src="@drawable/applock_num5"
            android:tag="@string/five" />

        <ImageView
            android:id="@+id/applock_keyboard_numsix"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="1.0dp"
            android:layout_weight="1"
            android:src="@drawable/applock_num6"
            android:tag="@string/six" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/applock_keyboard_three"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:paddingLeft="50dp"
        android:paddingRight="50dp" >

        <ImageView
            android:id="@+id/applock_keyboard_numseven"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:src="@drawable/applock_num7"
            android:tag="@string/seven" />

        <ImageView
            android:id="@+id/applock_keyboard_numeight"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="1.0dp"
            android:layout_weight="1"
            android:src="@drawable/applock_num8"
            android:tag="@string/eight" />

        <ImageView
            android:id="@+id/applock_keyboard_numnine"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="1.0dp"
            android:layout_weight="1"
            android:src="@drawable/applock_num9"
            android:tag="@string/nine" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/applock_keyboard_four"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:paddingLeft="50dp"
        android:paddingRight="50dp" >

        <Button
            android:id="@+id/applock_keyboard_clearall"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:textColor="#FF606061"
            android:textSize="20.0dp"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/applock_keyboard_numzero"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="1.0dp"
            android:layout_weight="1"
            android:src="@drawable/applock_num0"
            android:tag="@string/zero" />

        <ImageButton
            android:id="@+id/applock_keyboard_del"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_marginLeft="1.0dp"
            android:layout_weight="1"
            android:visibility="invisible" />
    </LinearLayout>

    <TextView
        android:id="@+id/applock_keyboard_change"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:text="@string/applock_setpws_change"
        android:textColor="@color/colorPrimary"
        android:textSize="15dp" />

</LinearLayout>
