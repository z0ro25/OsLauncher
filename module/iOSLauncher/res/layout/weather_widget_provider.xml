<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Weather NHỎ (2x2). Nền gradient xanh riêng (widget_weather_bg_blue), chữ trắng.
     LƯU Ý: LauncherAppWidgetHostView.onSizeChanged() ÉP setPadding(0,0,0,0) lên view ROOT của
     widget đặt màn -> KHÔNG đặt padding ở root (sẽ bị mất). Nền để ở root (full-bleed), nội dung
     bọc trong lớp con "content" giữ padding. Cùng quy ước với battery/clock. Dữ liệu MẪU TĨNH. -->
<!-- Root đổi từ LinearLayout sang FrameLayout để lớp phủ xin quyền nằm ĐÈ LÊN nội dung.
     Giữ nguyên id widget_weather_layout (code bind + gắn click theo id này). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_weather_layout"
    android:background="@drawable/widget_weather_bg_blue"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="start"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/weather_widget_padding">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/ic_weather_location" />

            <TextView
                android:id="@+id/widget_weather_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/weather_sample_city" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="normal"
            android:text="@string/weather_sample_temp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_weather_sun" />

            <TextView
                android:id="@+id/widget_weather_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:text="@string/weather_sample_condition" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_weather_highlow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:text="@string/weather_sample_highlow" />
    </LinearLayout>

    <!-- [CHƯA CẤP QUYỀN] Lớp phủ mờ + lời nhắc, đè lên nội dung mẫu khi app chưa có quyền vị trí.
         Bấm vào widget lúc này sẽ hiện hộp xin quyền (xem WeatherWidgetProvider.bindInflatedView).
         Mặc định GONE; code bật lên khi thiếu quyền. -->
    <LinearLayout
        android:id="@+id/widget_weather_permission"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_weather_permission_scrim"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_weather_location"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/widget_weather_need_permission"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/widget_picture_tap_to_grant"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
