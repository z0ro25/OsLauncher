<?xml version="1.0" encoding="utf-8"?>
<com.truongnt.ios.launcher.quickaccess.QuickAccess xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <RelativeLayout
        android:id="@+id/anim_view"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginBottom="50dp">

        <com.truongnt.ios.launcher.quickaccess.AppViewLayout
            android:id="@+id/first_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.truongnt.ios.launcher.quickaccess.AppViewLayout
            android:id="@+id/second_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible" />

        <com.truongnt.ios.launcher.quickaccess.AppViewLayout
            android:id="@+id/three_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible" />

        <com.truongnt.ios.launcher.quickaccess.SelectionView
            android:id="@+id/selection_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.truongnt.ios.launcher.quickaccess.SelectionTextView
            android:id="@+id/textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </RelativeLayout>
</com.truongnt.ios.launcher.quickaccess.QuickAccess>