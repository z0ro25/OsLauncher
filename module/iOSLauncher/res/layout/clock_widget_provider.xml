<?xml version="1.0" encoding="utf-8"?>
<!-- Đồng hồ Digital (#1 trong khay widget): KHUNG VUÔNG, thẻ TRẮNG + vòng vạch phút
     "sáng dồn theo giây" (acvSecondProgress) quanh mép + giờ ĐEN đậm ở giữa.
     Ô lưới 2x2 rộng hơn cao -> bọc ConstraintLayout, ép khối vuông 1:1 CĂN GIỮA
     (giống widget đồng hồ kim page 0) để khung vuông đều. Vạch vẽ bằng AnalogClockView
     chế độ acvTicksOnly (chỉ vòng vạch, không mặt/kim/số). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Khối VUÔNG 1:1 căn giữa: giữ id widget_clock_layout để code cũ bám không đổi. -->
    <FrameLayout
        android:id="@+id/widget_clock_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Nền KÍNH MỜ (blur wallpaper); fallback thẻ TRẮNG theo theme khi máy không hỗ trợ blur.
             Tint trắng đậm để giờ ĐEN đọc rõ trên nền wallpaper bất kỳ. -->
        <com.amz.ios.launcher.widget.view.GlassBlurView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:gbvCornerRadius="@dimen/widget_round_corner"
            app:gbvBorderColor="#33FFFFFF"
            app:gbvBorderWidth="1dp"
            app:gbvOverlayColor="#CCFFFFFF"
            app:gbvFallbackDrawable="@drawable/widget_clock_card_white" />

        <com.amz.ios.launcher.widget.view.AnalogClockView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/widget_padding"
            app:acvDial="day"
            app:acvTicksOnly="true"
            app:acvSecondProgress="true" />

        <TextClock
            android:id="@+id/widget_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/black"
            android:textSize="34sp"
            android:textStyle="bold"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
