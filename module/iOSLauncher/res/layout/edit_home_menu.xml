<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown hiển thị khi bấm nút "Edit" ở góc trái-trên trong chế độ chỉnh sửa home screen.
     Gồm 3 chức năng: thêm tiện ích, chỉnh sửa page, background.
     [NỀN KÍNH] Nền + viền gắn RUNTIME bởi PopupGlassHelper, nên KHÔNG khai background/foreground ở
     đây (khai thêm chỉ bị ghi đè). Helper còn áp RenderEffect blur lên lớp workspace phía sau khi
     popup mở, nên icon app bên dưới thật sự NHOÈ — giống ảnh mẫu iOS.

     Hai cách trước đều KHÔNG đạt, ghi lại để khỏi quay lại:
       - RealtimeBlurView (RenderScript): RenderScript bị gỡ từ Android 12 -> fallback rỗng, không
         blur gì, chỉ còn tint phẳng.
       - GlassBlurWindowController (compositor blur của hotseat): window TYPE_APPLICATION_MEDIA xếp
         DƯỚI window chính nên nền kính chui xuống dưới icon app, nhìn xuyên qua vẫn đọc rõ nội dung.

     Mặt kính sáng nên chữ + icon dùng màu TỐI (@color/popup_glass_text), không cần shadow. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">


    <LinearLayout
        android:id="@+id/menu_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="150dp"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/menu_add_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_widget" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:text="@string/add_widget"
                android:textColor="@color/popup_glass_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_edit_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_edit_home"
                android:tint="@color/popup_glass_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:text="@string/edit_page"
                android:textColor="@color/popup_glass_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_gallery"
                android:tint="@color/popup_glass_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:text="@string/background"
                android:textColor="@color/popup_glass_text"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
