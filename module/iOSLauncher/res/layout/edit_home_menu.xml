<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown hiển thị khi bấm nút "Edit" ở góc trái-trên trong chế độ chỉnh sửa home screen.
     Gồm 3 chức năng: thêm tiện ích, chỉnh sửa page, background.
     Popup NẰM TRÊN các icon app -> phải làm MỜ CHÍNH CÁC ICON phía sau (nhìn app dưới mờ mờ).
     Vì vậy KHÔNG dùng compositor blur (DockBlurView/GlassCompositorBlurView) — loại đó là overlay
     window MEDIA nằm DƯỚI window chính nên chỉ blur wallpaper, icon app vẽ ĐÈ LÊN vẫn nét (đúng
     cho dock nhưng SAI cho popup). Dùng RealtimeBlurView: nó blur nội dung decorView của launcher
     (= các icon app) ngay sau popup -> app dưới mờ. Tint TRẮNG nhẹ (không đen) + viền glass qua
     bg_glass_popup (foreground) để vẫn ra chất kính sáng giống hotseat. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_popup"
    android:clipToOutline="true"
    android:foreground="@drawable/bg_glass_popup">

    <com.github.mmin18.widget.RealtimeBlurView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/menu_container"
        android:layout_alignBottom="@+id/menu_container"
        android:layout_alignStart="@+id/menu_container"
        android:layout_alignEnd="@+id/menu_container"
        app:realtimeBlurRadius="100dp"
        app:realtimeDownsampleFactor="8"
        app:realtimeOverlayColor="#80000000" />

    <LinearLayout
        android:id="@+id/menu_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="180dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/menu_add_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:text="@string/add_widget"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_edit_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_edit_home"
                android:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:text="@string/edit_page"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_wallpaper" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:text="@string/background"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
