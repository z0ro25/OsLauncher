<?xml version="1.0" encoding="utf-8"?>
<com.amz.ios.launcher.widget.SlidingUpWidgetsCellAppStyle xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:gravity="bottom" android:id="@+id/sliding_up_widgets_app_style" android:focusable="true" android:fitsSystemWindows="true" android:clickable="true" android:descendantFocusability="afterDescendants" android:layout_width="match_parent" android:layout_height="match_parent" app:umanoDragView="@+id/widgets_content" app:umanoInitialState="collapsed" app:umanoOverlay="true" app:umanoPanelHeight="0dp" app:umanoScrollableView="@+id/left_page_widgets_lists" app:umanoShadowHeight="0dp">
    <View android:layout_width="match_parent" android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout android:gravity="center_horizontal" android:orientation="vertical" android:id="@+id/widgets_content" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="160dp">
        <!-- Nền đục (không blur) theo theme, bo 2 góc trên. Drawable set runtime. -->
        <View android:id="@+id/widget_sheet_bg" android:layout_width="0dp" android:layout_height="0dp" android:background="@drawable/widget_sheet_bg_white" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

        <!-- Thanh grabber NÉT vẽ ĐÈ trên lớp kính. -->
        <View android:id="@+id/widget_sheet_grabber" android:layout_width="36dp" android:layout_height="5dp" android:layout_marginTop="10dp" android:background="@drawable/widget_sheet_grabber" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

        <!-- Header: icon widget + tên nhóm (trái) + nút X đóng (phải). Đổi theo trang khi vuốt. -->
        <ImageView android:id="@+id/widget_sheet_icon" android:layout_width="34dp" android:layout_height="34dp" android:scaleType="fitCenter" android:contentDescription="@string/add_widget" android:layout_marginStart="20dp" android:layout_marginTop="20dp" app:layout_constraintTop_toBottomOf="@+id/widget_sheet_grabber" app:layout_constraintStart_toStartOf="parent" />
        <com.amz.ios.launcher.TextViewCustomFont android:id="@+id/widget_sheet_header_name" android:textSize="17dp" android:textStyle="bold" android:textColor="@color/white" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" app:layout_constraintTop_toTopOf="@+id/widget_sheet_icon" app:layout_constraintBottom_toBottomOf="@+id/widget_sheet_icon" app:layout_constraintStart_toEndOf="@+id/widget_sheet_icon" app:layout_constraintEnd_toStartOf="@+id/widget_sheet_close" />
        <ImageView android:id="@+id/widget_sheet_close" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/widget_sheet_close" android:contentDescription="@string/cancel_state" android:layout_marginEnd="20dp" app:layout_constraintTop_toTopOf="@+id/widget_sheet_icon" app:layout_constraintBottom_toBottomOf="@+id/widget_sheet_icon" app:layout_constraintEnd_toEndOf="parent" />

        <!-- Tiêu đề lớn + mô tả, căn giữa. Đổi theo trang khi vuốt. -->
        <com.amz.ios.launcher.TextViewCustomFont android:id="@+id/widget_sheet_title" android:textSize="26dp" android:textStyle="bold" android:textColor="@color/white" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginTop="20dp" app:layout_constraintTop_toBottomOf="@+id/widget_sheet_icon" />
        <com.amz.ios.launcher.TextViewCustomFont android:id="@+id/widget_sheet_desc" android:textSize="15dp" android:textColor="#8E8E93" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginTop="6dp" app:layout_constraintTop_toBottomOf="@+id/widget_sheet_title" />

        <!-- Khung preview các size (vuốt ngang). Cao co theo tỉ lệ lưới ở code. -->
        <androidx.viewpager.widget.ViewPager android:id="@+id/view_pager_widgets_scroll_container" android:clipChildren="false" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@+id/widget_sheet_desc" app:layout_constraintBottom_toTopOf="@+id/widget_sheet_dots" />

        <!-- Hàng chấm chỉ trang, số chấm dựng ở code theo số size. -->
        <LinearLayout android:id="@+id/widget_sheet_dots" android:orientation="horizontal" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:layout_constraintBottom_toTopOf="@+id/add_button_widgets_app_style" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.AppCompatButton android:textSize="15dp" android:textColor="@color/white" android:id="@+id/add_button_widgets_app_style" android:background="@drawable/rounded_button_background" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/sliding_up_widgets_app_style_page_margin" android:text="@string/add_widget" android:layout_marginStart="@dimen/sliding_up_widgets_app_style_page_margin" android:layout_marginEnd="@dimen/sliding_up_widgets_app_style_page_margin" app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.amz.ios.launcher.widget.SlidingUpWidgetsCellAppStyle>
