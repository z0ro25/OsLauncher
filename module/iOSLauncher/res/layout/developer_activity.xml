<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.truongnt.ios.launcher.views.TopTitlebar
            android:id="@+id/titlebar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            launcher:titleText="@string/developer_mode" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.truongnt.ios.launcher.views.CustomTextView
                    style="@style/pref_subtitle"
                    android:text="@string/category_version_detail" />

                <com.truongnt.ios.ioslite.common.view.InfoItemLayout
                    android:id="@+id/build_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:itemInfoTitle="@string/build_version_type" />

                <com.truongnt.ios.ioslite.common.view.InfoItemLayout
                    android:id="@+id/build_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:itemInfoTitle="@string/build_version_channel" />

                <com.truongnt.ios.ioslite.common.view.InfoItemLayout
                    android:id="@+id/build_customer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:itemInfoTitle="@string/build_version_customer" />

                <com.truongnt.ios.ioslite.common.view.InfoItemLayout
                    android:id="@+id/build_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:itemInfoTitle="@string/build_version_time" />

                <com.truongnt.ios.ioslite.common.view.InfoItemLayout
                    android:id="@+id/custom_config_pkg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:itemInfoTitle="@string/custom_config_pkg" />

                <include
                    android:id="@+id/settings_default_launcher_gap"
                    layout="@layout/preference_gap" />

                <com.truongnt.ios.launcher.views.CustomTextView
                    style="@style/pref_subtitle"
                    android:text="@string/category_device_detail" />

                <com.truongnt.ios.ioslite.common.view.InfoItemLayout
                    android:id="@+id/device_imei"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:itemInfoTitle="@string/device_imei" />

                <com.truongnt.ios.ioslite.common.view.InfoItemLayout
                    android:id="@+id/device_imsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:itemInfoTitle="@string/device_imsi" />

                <com.truongnt.ios.ioslite.common.view.InfoItemLayout
                    android:id="@+id/device_brand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:itemInfoTitle="@string/device_brand" />

                <include
                    android:id="@+id/settings_default_launcher_gap"
                    layout="@layout/preference_gap" />

                <com.truongnt.ios.launcher.views.CustomTextView
                    style="@style/pref_subtitle"
                    android:text="@string/category_launcher" />

                <com.truongnt.ios.launcher.views.IOSPreference
                    android:id="@+id/appCategory"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceTitle="@string/debug_app_category"
                    launcher:rightImage="rightArrow" />

                <com.truongnt.ios.launcher.views.IOSPreference
                    android:id="@+id/memoryTracker"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceTitle="@string/memory_tracker_window"
                    launcher:rightImage="showSwitch" />

                <com.truongnt.ios.launcher.views.IOSPreference
                    android:id="@+id/build_workspace"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceTitle="@string/build_workspace_xml" />

                <com.truongnt.ios.launcher.views.IOSPreference
                    android:id="@+id/dump_allapps"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceTitle="@string/dump_allapps" />

                <include
                    android:id="@+id/settings_default_launcher_gap"
                    layout="@layout/preference_gap" />

                <com.truongnt.ios.launcher.views.CustomTextView
                    style="@style/pref_subtitle"
                    android:text="@string/category_advertise" />

                <com.truongnt.ios.launcher.views.IOSPreference
                    android:id="@+id/advertise_controll"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceTitle="@string/debug_advertise_controll"
                    launcher:rightImage="rightArrow" />

                <com.truongnt.ios.launcher.views.IOSPreference
                    android:id="@+id/advertise_source"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceTitle="@string/debug_advertise_source"
                    launcher:rightImage="rightArrow" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>