<?xml version="1.0" encoding="utf-8"?>
<!-- Mini analog: 1 tile 2x2 chứa lưới 2x2 gồm 4 đồng hồ kim nhỏ theo thành phố.
     Nền glass; mỗi ô: đồng hồ kim (không số, không kim giây) + nhãn city. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.amz.ios.launcher.widget.view.GlassBlurView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:gbvOverlayColor="#00000000"
        app:gbvCornerRadius="@dimen/widget_round_corner"
        app:gbvBorderColor="#40FFFFFF"
        app:gbvBorderWidth="1dp"
        app:gbvFallbackDrawable="@drawable/bg_glass_1_1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:weightSum="2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.amz.ios.launcher.widget.view.AnalogClockView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:acvShowNumbers="false"
                app:acvShowSecond="false"
                app:acvTimeZone="America/New_York" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NYC"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.amz.ios.launcher.widget.view.AnalogClockView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:acvShowNumbers="false"
                app:acvShowSecond="false"
                app:acvTimeZone="Europe/London" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LON"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.amz.ios.launcher.widget.view.AnalogClockView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:acvShowNumbers="false"
                app:acvShowSecond="false"
                app:acvTimeZone="Asia/Dubai" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DXB"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.amz.ios.launcher.widget.view.AnalogClockView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:acvShowNumbers="false"
                app:acvShowSecond="false"
                app:acvTimeZone="Australia/Sydney" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYD"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
