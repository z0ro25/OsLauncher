<?xml version="1.0" encoding="utf-8"?>
<!-- World Clock lưới 2x2 (tile 2x2): thẻ TỐI, 4 mặt số mini theo thành phố. Mỗi mặt:
     có số + kim giây cam, tự đổi ngày/đêm theo giờ địa phương, và nhãn tp viết tắt vẽ
     BÊN TRONG mặt (acvLabel) — không còn nhãn dưới mặt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Nền KÍNH MỜ (blur wallpaper); fallback thẻ TỐI theo theme khi máy không hỗ trợ blur. -->
    <com.amz.ios.launcher.widget.view.GlassBlurView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:gbvCornerRadius="@dimen/widget_round_corner"
        app:gbvBorderColor="#40FFFFFF"
        app:gbvBorderWidth="1dp"
        app:gbvOverlayColor="#73000000"
        app:gbvFallbackDrawable="@drawable/widget_clock_card_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp"
        android:weightSum="2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="2">

        <com.amz.ios.launcher.widget.view.AnalogClockView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:acvShowSecond="true"
            app:acvLabel="NYC"
            app:acvTimeZone="America/New_York" />

        <com.amz.ios.launcher.widget.view.AnalogClockView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:acvShowSecond="true"
            app:acvLabel="LON"
            app:acvTimeZone="Europe/London" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="2">

        <com.amz.ios.launcher.widget.view.AnalogClockView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:acvShowSecond="true"
            app:acvLabel="DUB"
            app:acvTimeZone="Asia/Dubai" />

        <com.amz.ios.launcher.widget.view.AnalogClockView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:acvShowSecond="true"
            app:acvLabel="SYD"
            app:acvTimeZone="Australia/Sydney" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
