<?xml version="1.0" encoding="utf-8"?>
<!-- Digital city+offset (2x2): giờ số lớn theo múi giờ New York + tên city +
     chênh lệch giờ. Nền glass. TextClock tự tick; WorldClockTextView tự cập nhật. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.amz.ios.launcher.widget.view.GlassBlurView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:gbvOverlayColor="#00000000"
        app:gbvCornerRadius="@dimen/widget_round_corner"
        app:gbvBorderColor="#40FFFFFF"
        app:gbvBorderWidth="1dp"
        app:gbvFallbackDrawable="@drawable/bg_glass_1_1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/widget_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NYC"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/white"
        android:textSize="34sp"
        android:textStyle="bold"
        android:timeZone="America/New_York"
        android:format12Hour="hh:mm"
        android:format24Hour="HH:mm" />

    <com.amz.ios.launcher.widget.view.WorldClockTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:alpha="0.7"
        app:wctvMode="diff"
        app:wctvTimeZone="America/New_York" />
    </LinearLayout>
</FrameLayout>
