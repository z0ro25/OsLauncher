<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_box"
        android:background="@drawable/round_rect_qsb"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintEnd_toStartOf="@+id/action_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ic_search"
            android:padding="0dp"
            android:duplicateParentState="true"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/app_name"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintEnd_toStartOf="@+id/et_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.amz.ios.launcher.ExtendedEditText
            android:id="@+id/et_search"
            android:textColor="@color/white"
            android:textColorHint="@color/white_50"
            android:layout_gravity="start"
            android:background="@null"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/abandoned_search"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="flagNoExtractUi|actionSearch"
            android:textAlignment="viewStart"
            android:textCursorDrawable="@drawable/cursor_line"
            android:layout_marginLeft="10dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ic_search"
            app:layout_constraintTop_toTopOf="parent"/>
        <!-- Nút X xoá text: 24dp căn giữa-mép phải; có marginEnd 10dp không dính mép box. Voice & Clear dùng
             CHUNG vị trí (end) nên không lệch khi cái này hiện cái kia ẩn. et_search chừa marginEnd 40dp để
             text không chạy vào icon. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/action_clear"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_clear_search"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/action_voice"
            android:duplicateParentState="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_micro"
            android:visibility="gone"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.amz.ios.launcher.TextViewCustomFont
        android:textColor="@color/white_50"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/action_back"
        android:visibility="gone"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@android:string/cancel"
        android:textAllCaps="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:customFont="1"
        app:layout_constraintBottom_toBottomOf="@+id/search_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/search_box"/>
    <com.amz.ios.launcher.overscroll.OverScrollLayout
        android:id="@+id/overscroll_layout"
        android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@+id/search_box">
        <ScrollView android:id="@+id/scroll_view" android:fitsSystemWindows="true" android:scrollbars="none" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:orientation="vertical" android:id="@+id/result_layout" android:animationCache="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:animateLayoutChanges="true">
                <!-- Khung KẾT QUẢ app khớp (chỉ hiện khi gõ CÓ kết quả). Đứng trước header Gợi ý. -->
                <LinearLayout android:orientation="vertical" android:id="@+id/result_app_box" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
                    <com.amz.ios.launcher.TextViewCustomFont android:textColor="@color/white_50" android:gravity="start" android:id="@+id/result_app_title" android:paddingLeft="6dp" android:paddingTop="10dp" android:paddingRight="6dp" android:paddingBottom="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search_results_title" android:textAllCaps="true" android:paddingStart="6dp" android:paddingEnd="6dp" app:customFont="1"/>
                    <com.amz.ios.launcher.searchview.ExpandableHeightRecyclerView android:id="@+id/result_app_list" android:background="@drawable/round_rect_qsb" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
                <!-- Header GỢI Ý: tiêu đề + nút "Xem thêm" (mở rộng lưới 4 -> 8). Padding đáy để text không
                     sát khung lưới bên dưới. -->
                <LinearLayout android:orientation="horizontal" android:id="@+id/header_suggestion" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp">
                    <com.amz.ios.launcher.TextViewCustomFont android:textColor="@color/white" android:gravity="start" android:layout_gravity="center" android:id="@+id/suggestion_text" android:paddingLeft="6dp" android:paddingTop="10dp" android:paddingRight="6dp" android:focusable="true" android:clickable="true" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/suggestions" android:textAllCaps="true" android:paddingStart="6dp" android:paddingEnd="6dp" app:customFont="1"/>
                    <com.amz.ios.launcher.TextViewCustomFont android:textColor="@color/white" android:gravity="end" android:layout_gravity="center" android:id="@+id/action_show_more" android:paddingLeft="6dp" android:paddingTop="10dp" android:paddingRight="6dp" android:focusable="true" android:clickable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search_show_more" android:paddingStart="6dp" android:paddingEnd="6dp" app:customFont="1"/>
                </LinearLayout>
                <com.amz.ios.launcher.searchview.ExpandableHeightRecyclerView android:id="@+id/suggestion_list" android:background="@drawable/round_rect_qsb" android:focusable="true" android:visibility="visible" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <!-- List gợi ý DỌC (1 cột, icon trái + tên phải) — hiển thị khi ĐANG GÕ (có/không kết quả). -->
                <com.amz.ios.launcher.searchview.ExpandableHeightRecyclerView android:id="@+id/suggestion_list_vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
                <!-- Mục LỊCH SỬ app mở từ search: tiêu đề + nút "Xóa" + lưới; cả cụm ẩn khi rỗng -->
                <LinearLayout android:orientation="vertical" android:id="@+id/history_layout" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <LinearLayout android:orientation="horizontal" android:id="@+id/header_history" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.amz.ios.launcher.TextViewCustomFont android:textColor="@color/white_50" android:gravity="start" android:layout_gravity="center" android:id="@+id/history_text" android:paddingLeft="6dp" android:paddingTop="10dp" android:paddingRight="6dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/search_history_title" android:textAllCaps="true" android:paddingStart="6dp" android:paddingEnd="6dp" app:customFont="1"/>
                        <com.amz.ios.launcher.TextViewCustomFont android:textColor="@color/white" android:gravity="end" android:layout_gravity="center" android:id="@+id/action_clear_history" android:paddingLeft="6dp" android:paddingTop="10dp" android:paddingRight="6dp" android:focusable="true" android:clickable="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search_history_clear" android:paddingStart="6dp" android:paddingEnd="6dp" app:customFont="1"/>
                    </LinearLayout>
                    <com.amz.ios.launcher.searchview.ExpandableHeightRecyclerView android:id="@+id/history_list" android:background="@drawable/round_rect_qsb" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:orientation="vertical" android:id="@+id/other_search_layout" android:background="@drawable/round_rect_qsb" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
                    <LinearLayout android:gravity="end" android:orientation="horizontal" android:id="@+id/search_web" android:background="@drawable/item_button_state" android:paddingTop="8dp" android:paddingBottom="8dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.amz.ios.launcher.TextViewCustomFont android:textColor="@color/white" android:gravity="center_vertical" android:layout_gravity="end" android:layout_width="0dp" android:layout_height="28dp" android:text="@string/search_web" android:layout_weight="1" app:customFont="1"/>
                        <com.amz.ios.launcher.RoundedImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/safari_icon" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                    </LinearLayout>
                    <View android:background="#64ffffff" android:layout_width="match_parent" android:layout_height="1px"/>
                    <LinearLayout android:gravity="end" android:orientation="horizontal" android:id="@+id/search_store" android:background="@drawable/item_button_state" android:paddingTop="8dp" android:paddingBottom="8dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.amz.ios.launcher.TextViewCustomFont android:textColor="@color/white" android:gravity="center_vertical" android:layout_gravity="end" android:layout_width="0dp" android:layout_height="28dp" android:text="@string/search_store" android:layout_weight="1" app:customFont="1"/>
                        <com.amz.ios.launcher.RoundedImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/store_icon" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                    </LinearLayout>
                    <View android:background="#64ffffff" android:layout_width="match_parent" android:layout_height="1px"/>
                    <LinearLayout android:gravity="end" android:orientation="horizontal" android:id="@+id/search_maps" android:background="@drawable/item_button_state" android:paddingTop="8dp" android:paddingBottom="8dp" android:focusable="true" android:clickable="true" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <com.amz.ios.launcher.TextViewCustomFont android:textColor="@color/white" android:gravity="center_vertical" android:layout_gravity="end" android:layout_width="0dp" android:layout_height="28dp" android:text="@string/search_maps" android:layout_weight="1" app:customFont="1"/>
                        <com.amz.ios.launcher.RoundedImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/google_maps_icon" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.amz.ios.launcher.overscroll.OverScrollLayout>
</merge>
