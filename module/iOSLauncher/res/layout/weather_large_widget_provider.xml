<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Weather LARGE (4x4). Nền gradient xanh riêng. Bố cục khớp ảnh design:
     header + dải giờ (9AM..2PM) + dự báo NGÀY Tue..Sat, mỗi dòng:
     [ngày] [icon] [nhiệt thấp] [thanh dải nhiệt] [nhiệt cao].
     Thanh dải nhiệt = track mờ + segment màu, VỊ TRÍ do 3 spacer chia layout_weight (mockup
     tĩnh, quy ước dải 40°..70°). Dữ liệu MẪU TĨNH (dự án chưa có API thời tiết).
     LƯU Ý: host ép setPadding(0) lên ROOT -> padding phải nằm ở lớp con "content". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/widget_weather_bg_blue"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/weather_widget_padding">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/ic_weather_location" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/weather_sample_city" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:text="@string/weather_sample_temp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_weather_sun" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:text="@string/weather_sample_condition" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:text="@string/weather_sample_highlow" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dải giờ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="12sp" android:text="9AM" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:src="@drawable/ic_weather_sun" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" android:text="52°" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="12sp" android:text="10AM" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:src="@drawable/ic_weather_sun" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" android:text="54°" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="12sp" android:text="11AM" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:src="@drawable/ic_weather_cloud" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" android:text="56°" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="12sp" android:text="12PM" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:src="@drawable/ic_weather_sun" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" android:text="58°" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="12sp" android:text="1PM" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:src="@drawable/ic_weather_sun" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" android:text="60°" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="12sp" android:text="2PM" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:src="@drawable/ic_weather_cloud" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" android:text="61°" />
        </LinearLayout>
    </LinearLayout>

    <!-- Đường kẻ mờ ngăn giờ / ngày -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="#33FFFFFF" />

    <!-- Dự báo NGÀY (Tue..Sat) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Tue: L50 H62 (dải 40..70 -> 33/40/27) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:text="Tue" />
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_weather_sun" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="end"
                android:textColor="#CCFFFFFF" android:textSize="14sp" android:text="50°" />
            <LinearLayout android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:orientation="horizontal" android:background="@drawable/weather_range_track">
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="33" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="40" android:background="@drawable/weather_range_segment" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="27" />
            </LinearLayout>
            <TextView android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="start"
                android:textColor="@color/white" android:textSize="14sp" android:text="62°" />
        </LinearLayout>

        <!-- Wed: L48 H59 (27/37/36) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:text="Wed" />
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_weather_cloud" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="end"
                android:textColor="#CCFFFFFF" android:textSize="14sp" android:text="48°" />
            <LinearLayout android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:orientation="horizontal" android:background="@drawable/weather_range_track">
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="27" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="37" android:background="@drawable/weather_range_segment" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="36" />
            </LinearLayout>
            <TextView android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="start"
                android:textColor="@color/white" android:textSize="14sp" android:text="59°" />
        </LinearLayout>

        <!-- Thu: L52 H64 (40/40/20) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:text="Thu" />
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_weather_sun" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="end"
                android:textColor="#CCFFFFFF" android:textSize="14sp" android:text="52°" />
            <LinearLayout android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:orientation="horizontal" android:background="@drawable/weather_range_track">
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="40" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="40" android:background="@drawable/weather_range_segment" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="20" />
            </LinearLayout>
            <TextView android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="start"
                android:textColor="@color/white" android:textSize="14sp" android:text="64°" />
        </LinearLayout>

        <!-- Fri: L49 H60 (30/37/33) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:text="Fri" />
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_weather_sun" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="end"
                android:textColor="#CCFFFFFF" android:textSize="14sp" android:text="49°" />
            <LinearLayout android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:orientation="horizontal" android:background="@drawable/weather_range_track">
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="30" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="37" android:background="@drawable/weather_range_segment" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="33" />
            </LinearLayout>
            <TextView android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="start"
                android:textColor="@color/white" android:textSize="14sp" android:text="60°" />
        </LinearLayout>

        <!-- Sat: L51 H63 (37/40/23) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:text="Sat" />
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_weather_cloud" />
            <TextView android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="end"
                android:textColor="#CCFFFFFF" android:textSize="14sp" android:text="51°" />
            <LinearLayout android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:orientation="horizontal" android:background="@drawable/weather_range_track">
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="37" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="40" android:background="@drawable/weather_range_segment" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="23" />
            </LinearLayout>
            <TextView android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="start"
                android:textColor="@color/white" android:textSize="14sp" android:text="63°" />
        </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
