<?xml version="1.0" encoding="utf-8"?>
<!-- Widget đồng hồ kim lớn (page 0). Nền glass đậm, có kim giây + vạch chia giờ/phút
     kiểu iOS. Widget nội bộ nên inflate thành View thật -> dùng custom AnalogClockView. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_tile_strong"
    android:padding="@dimen/widget_padding">

    <com.amz.ios.launcher.widget.view.AnalogClockView
        android:id="@+id/analog_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:acvShowSecond="true"
        app:acvShowTicks="true" />
</FrameLayout>
