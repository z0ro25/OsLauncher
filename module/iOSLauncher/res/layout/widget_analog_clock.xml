<?xml version="1.0" encoding="utf-8"?>
<!-- Widget đồng hồ kim lớn (page 0). Nền kính blur COMPOSITOR (GlassCompositorBlurView) —
     cùng cơ chế hotseat (DockBlurView): blur ở tầng hệ thống, KHÔNG cần quyền đọc wallpaper
     nên luôn mờ được (kể cả máy Android 13+ chặn wallpaper). Có kim giây + vạch chia giờ/phút
     kiểu iOS. Widget nội bộ inflate thành View thật -> dùng custom view. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.amz.ios.launcher.widget.view.GlassCompositorBlurView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:gcbFallbackDrawable="@drawable/bg_glass_1_1" />

    <com.amz.ios.launcher.widget.view.AnalogClockView
        android:id="@+id/analog_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/widget_padding"
        app:acvShowSecond="true"
        app:acvShowTicks="true" />
</FrameLayout>
