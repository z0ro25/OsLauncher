<?xml version="1.0" encoding="utf-8"?>
<!-- Đồng hồ kim đơn (Clock I) — widget clock đặt sẵn ở PAGE 0 (default_workspace screen 0).
     Nền + mặt đồng hồ ĐƯỢC ÉP VUÔNG 1:1 CĂN GIỮA ô 2x2 (dùng layout_constraintDimensionRatio
     giống widget picture đã làm) -> nền vuông, khoảng cách từ hình tròn tới mép nền ĐỀU cả dọc
     lẫn ngang, không còn lệch do ô lưới không vuông.
     Nền KÍNH BLUR THẬT GIỐNG HỆT HOTSEAT bằng WidgetBlurView (kế thừa DockBlurView của dock:
     compositor background-blur, bán kính 60, tint #1AFFFFFF, viền dock_glass_*), thêm listener
     cuộn để overlay bám theo widget khi đổi trang. Mặt số/kim vẽ bởi AnalogClockView ở window
     chính -> luôn nét. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.amz.ios.launcher.widget.view.WidgetBlurView
        android:id="@+id/widget_analog_glass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.amz.ios.launcher.widget.view.AnalogClockView
        android:id="@+id/analog_clock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        app:acvDial="day"
        app:acvShowNumbers="true"
        app:acvShowSecond="true"
        app:acvShowTicks="true"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
