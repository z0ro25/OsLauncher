<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.amz.ios.launcher.views.TopTitlebar
            android:id="@+id/titlebar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            launcher:titleText="@string/drawer_style" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/alpha_vertical"
                    layout="@layout/desktop_style_setting_item" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.0px"
                    android:background="@color/pref_item_divider" />

                <include
                    android:id="@+id/full_vertical"
                    layout="@layout/desktop_style_setting_item" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>