<?xml version="1.0" encoding="utf-8"?>
<!-- Widget ảnh đặt sẵn ở PAGE 0 (default_workspace screen 0, PictureAppWidgetProvider →
     initialLayout của picture_app_widget_provider_info.xml).
     Khối ảnh LẤP ĐẦY Ô LƯỚI (bỏ ép vuông 1:1). Lý do: dấu trừ lúc edit được neo theo bounds của
     host, nên nội dung phải trùng bounds host thì dấu trừ mới không lệch vào trong — quy ước
     chung cho mọi widget. Ảnh dùng centerCrop nên vẫn đầy khung, không méo. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Khối lấp đầy ô: giữ id/nền bo góc/click như cũ để code (bindInflatedView,
         updateWidget, onClick) vẫn hoạt động nguyên vẹn. -->
    <FrameLayout
        android:id="@+id/widget_picture_layout"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/widget_picture_clip_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ảnh đã được bo góc trong code (RoundedBitmapDrawable). src mẫu để preview không trống. -->
        <ImageView
            android:id="@+id/widget_picture_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/sample_photo_widget" />

        <!-- Lớp phủ tối dần ở đáy để overlay chữ luôn đọc rõ. -->
        <View
            android:id="@+id/widget_picture_scrim"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:background="@drawable/widget_picture_date_scrim" />

        <!-- Overlay góc dưới-trái: "ON THIS DAY" + ngày chụp. Ẩn cả khối khi dùng ảnh default. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/widget_picture_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:text="@string/widget_picture_on_this_day" />

            <TextView
                android:id="@+id/widget_picture_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Chưa chọn ảnh: lớp phủ mời chọn ảnh, bấm widget mở Photo Picker.
             Giữ id cũ vì code bật/tắt theo id; mặc định GONE. -->
        <LinearLayout
            android:id="@+id/widget_picture_permission"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_picture_permission_scrim"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_gallery"
                android:tint="@color/white"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:gravity="center"
                android:text="@string/widget_picture_choose_photo"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
