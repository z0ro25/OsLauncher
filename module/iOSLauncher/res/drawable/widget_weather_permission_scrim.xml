<?xml version="1.0" encoding="utf-8"?>
<!-- Nền lớp phủ "cần cấp quyền" của widget thời tiết.

     BO GÓC bằng bán kính widget: nếu để màu phẳng thì lớp phủ vuông góc trong khi widget bo tròn
     -> lòi 4 góc đen. (Lỗi này đã gặp ở widget ảnh.)
     Không dựa được vào clipToOutline của cha: RemoteViews không cho set thuộc tính đó, mà widget
     thời tiết vẽ qua cả đường RemoteViews lẫn đường inflate trực tiếp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#99000000" />
    <corners android:radius="@dimen/widget_round_corner" />
</shape>
