<?xml version="1.0" encoding="utf-8"?>
<!-- Khung glass tĩnh (frosted) bao cả hàng icon dock — kiểu dock iOS.
     Giống bg_glass_tile nhưng bo góc lớn hơn cho thanh dock. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="28dp"/>
    <gradient
        android:angle="270"
        android:startColor="#33FFFFFF"
        android:endColor="#1AFFFFFF"
        android:type="linear"/>
    <stroke
        android:width="0.5dp"
        android:color="#26FFFFFF"/>
</shape>
