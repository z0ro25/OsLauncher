<?xml version="1.0" encoding="UTF-8"?>
<!-- Khung folder khi mở: glass thật kiểu iOS. Panel gần như TRONG SUỐT (chỉ tint
     trắng ~8%) để lộ chính lớp wallpaper đã blur bên dưới, cộng viền sáng mảnh
     bao quanh phân tách khung với vùng ngoài. Vùng ngoài blur mạnh (alpha ~1.0
     trong BlurScreenLayout) nên trong/ngoài khung cùng độ frost, chỉ khác ở viền. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="40dp" />
    <solid android:color="#14FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#80FFFFFF" />
</shape>
