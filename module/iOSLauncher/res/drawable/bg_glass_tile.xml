<?xml version="1.0" encoding="utf-8"?>
<!-- Khung glass tĩnh (frosted) cho pod App Library — theo Figma node 1:3413.
     Nền trắng trong suốt gradient 20% -> 10%, viền kính mảnh, bo góc widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/widget_round_corner"/>
    <gradient
        android:angle="270"
        android:startColor="#33FFFFFF"
        android:endColor="#1AFFFFFF"
        android:type="linear"/>
    <stroke
        android:width="0.5dp"
        android:color="#26FFFFFF"/>
</shape>
