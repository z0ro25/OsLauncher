<?xml version="1.0" encoding="utf-8"?>
<!-- Nền thẻ TỐI (gradient) cho widget Battery ở khay/đặt màn. Prefix widget_battery_ để
     KHÔNG dùng chung với round_rect_qsb_dark (thẻ battery left-page vẫn giữ nền cũ).
     Gradient trên sáng nhẹ -> dưới tối hơn, giống design iOS. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF2E2E30"
        android:endColor="#FF161618" />
    <corners android:radius="@dimen/widget_round_corner" />
</shape>
