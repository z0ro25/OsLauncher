<?xml version="1.0" encoding="utf-8"?>
<!-- Nền 1 nút trong hàng chọn size ở đầu popup widget.
     Trạng thái ĐANG CHỌN (selected/activated): nền xám đậm hơn để nổi bật (như ảnh mẫu iOS —
     ô size hiện tại của widget được tô nền). Trạng thái thường: trong suốt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- DISABLED: dòng widget này không có biến thể ở cỡ đó -> nền phẳng, không phản hồi chạm.
         Phải đặt TRƯỚC state_selected: selector lấy item KHỚP ĐẦU TIÊN, nếu để sau thì ô vừa
         disabled vừa selected sẽ ăn nền "đang chọn" và trông như bấm được.
         Màu ICON bên trong do @color/widget_size_option_icon lo (ImageView khai
         duplicateParentState nên tự ăn theo state của ô này). -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#1F000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
