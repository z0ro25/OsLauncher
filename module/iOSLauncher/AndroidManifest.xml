            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:taskAffinity="com.amz.ios.launcher.Launcher"
            android:theme="@style/PrefSettings">
            <intent-filter>
                <action android:name="ioslite.intent.action.OPEN_FEATURE_SETTING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".config.GestureSettingActivity"
