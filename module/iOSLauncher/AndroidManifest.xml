            android:icon="@drawable/lite_rom_all_apps"
            android:label="@string/all_apps_button_label"
            android:resizeableActivity="false"></activity>


        <!--     ***********************    User Guide   ******************************  -->
        <activity
            android:name="com.ios.boot.iosboot.FirstRunActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/IOSBootAppTheme.Start">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ios.boot.iosboot.SpeedUpActivity"
            android:exported="true"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/IOSBootSpeddUpAppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.ios.boot.iosboot.UpdateInfoActivity"
            android:exported="true"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/IOSBootUpdateInfoAppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.ios.boot.iosboot.LegalNoticesActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.amz.ios.ui.cropimage.CropImageActivity"
            android:configChanges="screenSize|screenLayout|orientation"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!--     ***********************    User Guide  End  ******************************  -->

        <receiver
            android:name="com.ios.cleanwidget.CleanWidgetProvider"
            android:exported="true"
            android:label="@string/clean_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.IOS_WIDGET" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clean_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.widgetprovider.PictureAppWidgetProvider"
            android:exported="true"
            android:label="@string/picture">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.IOS_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/picture_app_widget_provider_info" />
        </receiver>

        <receiver
            android:name=".widget.widgetprovider.BatteryWidgetProvider"
            android:exported="true"
            android:label="@string/battery">
            <intent-filter>
                <action android:name="android.appwidget.action.IOS_WIDGET" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.ios.ACTION_UPDATE_BATTERY_WIDGET" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_widget_provider_info" />
        </receiver>

        <receiver
            android:name=".widget.widgetprovider.ClockWidgetProvider"
            android:exported="true"
            android:label="@string/clock">
            <intent-filter>
                <action android:name="android.appwidget.action.IOS_WIDGET" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_provider_info" />
        </receiver>

        <receiver
            android:name="com.amz.ios.launcher.WorkspaceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ios.workspace.ACTION_DEBUG" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data
                    android:host="6633"
                    android:scheme="android_secret_code" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.amz.ios.launcher.dynamicui.WallpaperManagerCompatVL$ColorExtractionService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:process=":wallpaper_chooser" />

        <service
            android:name="com.amz.ios.launcher.notification.NotificationListener"
