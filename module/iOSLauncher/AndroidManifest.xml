    <application
        android:name="com.amz.ios.IOSLauncher"
        android:hardwareAccelerated="true"
        android:label="@string/launcher_application_name"
        android:screenOrientation="portrait">

        <activity
            android:name="com.amz.ios.launcher.searchlauncher.SearchLauncher"
            android:clearTaskOnLaunch="true"
            android:configChanges="fontScale|colorMode|layoutDirection|density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard|touchscreen|locale|mnc|mcc"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:taskAffinity="com.amz.ios.launcher.Launcher"
            android:theme="@style/LauncherTheme"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.MONKEY" />
                <category android:name="android.intent.category.LAUNCHER_APP" />
<!--                <category android:name="android.intent.category.LAUNCHER" />-->
            </intent-filter>
        </activity>

        <activity
            android:name="com.amz.ios.launcher.DynamicVirtualEntryActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/launcher_application_name"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">

            <intent-filter>
                <!--   App Lock Use -->
                <category android:name="android.intent.category.DEFAULT" />
                <action android:name="ioslite.intent.action.IOSLITE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".config.LauncherSettingActivity"
            android:autoRemoveFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_setting"
            android:label="@string/settings_label"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:taskAffinity="com.amz.ios.launcher.Launcher"
            android:theme="@style/PrefSettings">
            <intent-filter>
                <!--   App Lock Use -->
                <!--                <action android:name="android.intent.action.MAIN" />-->
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
            </intent-filter>
        </activity>

        <activity
            android:name=".config.AppearanceActivity"
            android:autoRemoveFromRecents="true"
            android:exported="true"
            android:label="@string/settings_label"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:taskAffinity="com.amz.ios.launcher.Launcher"
            android:theme="@style/PrefSettings" />

        <activity
            android:name=".config.DesktopStyleActivity"
            android:autoRemoveFromRecents="true"
