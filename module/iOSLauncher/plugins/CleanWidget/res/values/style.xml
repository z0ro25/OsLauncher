<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CleanIconText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:gravity">center_horizontal|top</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:shadowRadius">2.0</item>
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="ActItemStyle">
        <item name="android:visibility">invisible</item>
        <item name="android:layout_width">16.0dip</item>
        <item name="android:layout_height">16.0dip</item>
    </style>

    <style name="BaseCleanResultDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.3</item>
    </style>

    <style name="CleanResultDialog" parent="@style/BaseCleanResultDialog"></style>

</resources>