<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.amz.ios.launcher.views.TopTitlebar
            android:id="@+id/titlebar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            launcher:titleText="@string/setting_effects" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.amz.ios.launcher.views.IOSPreference
                    android:id="@+id/wallpaper_scroll"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceSummary="@string/setting_wallpaper_scrolling_summary"
                    launcher:preferenceTitle="@string/setting_wallpaper_scrolling"
                    launcher:rightImage="showSwitch" />

                <com.amz.ios.launcher.views.IOSPreference
                    android:id="@+id/app_trans_anim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceSummary="@string/pending_anim_summary"
                    launcher:preferenceTitle="@string/pending_anim_title"
                    launcher:rightImage="rightArrow" />

                <com.amz.ios.launcher.views.IOSPreference
                    android:id="@+id/delete_anim"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceSummary="@string/drop_delete_anim_summary"
                    launcher:preferenceTitle="@string/drop_delete_anim_title"
                    launcher:rightImage="rightArrow" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>