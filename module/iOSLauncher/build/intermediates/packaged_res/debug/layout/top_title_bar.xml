<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/titlebar_layout"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="@dimen/pref_title_bar_height"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/back"
            android:layout_width="48.0dip"
            android:layout_height="match_parent"
            android:background="@drawable/pref_title_back_bg">

            <ImageView
                android:id="@+id/back_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/pref_title_back" />
        </FrameLayout>

        <com.amz.ios.launcher.views.CustomTextView
            android:id="@+id/title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingLeft="5.0dip"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="20.0sp" />

        <FrameLayout
            android:id="@+id/right_btn_layout"
            android:layout_width="48.0dip"
            android:layout_height="match_parent"
            android:background="@drawable/pref_title_back_bg">

            <ImageView
                android:id="@+id/refresh_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/pref_update"
                android:visibility="gone" />

        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/title_divider"
        android:layout_width="fill_parent"
        android:layout_height="1.0px"
        android:background="@color/title_bar_divider"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>