<com.amz.ios.launcher.widget.WidgetCell xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:paddingBottom="20dp"
    android:layout_height="120dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical">

        <!-- The image of the widget. This view does not support padding. Any placement adjustment
             should be done using margins. -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.amz.ios.launcher.widget.WidgetImageView
                android:id="@+id/widget_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/widget_preview_label_vertical_padding"
            android:paddingLeft="1dp"
            android:paddingRight="1dp">

            <!-- The name of the widget. -->
            <com.amz.ios.launcher.views.CustomTextView
                android:id="@+id/widget_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fadingEdge="horizontal"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:shadowColor="#B0000000"
                android:shadowRadius="2.0"
                android:singleLine="true"
                android:textColor="@color/launcher_white"
                android:textSize="12sp" />

            <!-- The original dimensions of the widget (can't be the same text as above due to different
                 style. -->
            <com.amz.ios.launcher.views.CustomTextView
                android:gravity="center"
                android:id="@+id/widget_dims"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:shadowColor="#B0000000"
                android:shadowRadius="2.0"
                android:textColor="@color/white70"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</com.amz.ios.launcher.widget.WidgetCell>