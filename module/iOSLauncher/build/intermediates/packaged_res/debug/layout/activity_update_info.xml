<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_transparent_updateinfo"
    android:gravity="center">

    <LinearLayout
        android:layout_width="@dimen/boot_speedup_rl_width"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingLeft="@dimen/boot_updateinfo_padding"
        android:paddingRight="@dimen/boot_updateinfo_padding"
        android:paddingTop="@dimen/boot_updateinfo_padding">

        <com.amz.ios.launcher.views.CustomTextView
            android:id="@+id/boot_updateinfo_title_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boot_updateinfo_title"
            android:textColor="@color/boot_speedup_big_text_color"
            android:textSize="@dimen/boot_updateinfo_title_text_size"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/boot_updateinfo_speed_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/boot_updateinfo_space_margintop"
            android:orientation="horizontal"
            android:visibility="invisible">

            <ImageView
                android:layout_width="@dimen/boot_updateinfo_icon_size"
                android:layout_height="@dimen/boot_updateinfo_icon_size"
                android:background="@mipmap/speed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/boot_updateinfo_space_marginleft"
                android:orientation="vertical">

                <com.amz.ios.launcher.views.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/boot_updateinfo_speed"
                    android:textColor="@color/boot_speedup_big_text_color"
                    android:textSize="@dimen/boot_updateinfo_icon_text_size" />

                <com.amz.ios.launcher.views.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/boot_updateinfo_speed_detail"
                    android:textColor="@color/boot_speedup_small_text_color"
                    android:textSize="@dimen/boot_speedup_small_text_size" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boot_updateinfo_news_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/boot_updateinfo_space_margintop"
            android:orientation="horizontal"
            android:visibility="invisible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/boot_updateinfo_space_marginleft"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.amz.ios.launcher.views.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/boot_updateinfo_news"
                    android:textColor="@color/boot_speedup_big_text_color"
                    android:textSize="@dimen/boot_updateinfo_icon_text_size" />

                <com.amz.ios.launcher.views.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/boot_updateinfo_news_detail"
                    android:textColor="@color/boot_speedup_small_text_color"
                    android:textSize="@dimen/boot_speedup_small_text_size" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/boot_updateinfo_icon_size"
                android:layout_height="@dimen/boot_updateinfo_icon_size"
                android:background="@mipmap/news" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boot_updateinfo_theme_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/boot_updateinfo_space_margintop"
            android:orientation="horizontal"
            android:visibility="invisible">

            <ImageView
                android:layout_width="@dimen/boot_updateinfo_icon_size"
                android:layout_height="@dimen/boot_updateinfo_icon_size"
                android:background="@mipmap/theme" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/boot_updateinfo_space_marginleft"
                android:orientation="vertical">

                <com.amz.ios.launcher.views.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/boot_updateinfo_theme"
                    android:textColor="@color/boot_speedup_big_text_color"
                    android:textSize="@dimen/boot_updateinfo_icon_text_size" />

                <com.amz.ios.launcher.views.CustomTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/boot_updateinfo_theme_detail"
                    android:textColor="@color/boot_speedup_small_text_color"
                    android:textSize="@dimen/boot_speedup_small_text_size" />
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/boot_updateinfo_setting_rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/boot_updateinfo_space_marginbottom"
            android:layout_marginTop="@dimen/boot_updateinfo_space_margintop"
            android:visibility="invisible">

            <Button
                android:id="@+id/boot_updateinfo_setting_btn"
                android:layout_width="@dimen/boot_updateinfo_setting_width"
                android:layout_height="@dimen/boot_updateinfo_setting_height"
                android:layout_alignParentRight="true"
                android:background="@drawable/boot_speedup_setting_btn_shape"
                android:gravity="center"
                android:text="@string/boot_updateinfo_setting_btn_text"
                android:textColor="@color/boot_speedup_setting_btn_text_color"
                android:textSize="@dimen/boot_speedup_setting_text_size" />

            <com.amz.ios.launcher.views.CustomTextView
                android:id="@+id/boot_updateinfo_setting_tv"
                android:layout_width="@dimen/boot_updateinfo_setting_width"
                android:layout_height="@dimen/boot_updateinfo_setting_height"
                android:layout_marginRight="@dimen/boot_speedup_setting_tv_marginright"
                android:layout_toLeftOf="@id/boot_updateinfo_setting_btn"
                android:gravity="center"
                android:text="@string/boot_updateinfo_tv_text"
                android:textColor="@color/boot_speedup_setting_tv_text_color"
                android:textSize="@dimen/boot_speedup_setting_text_size" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>