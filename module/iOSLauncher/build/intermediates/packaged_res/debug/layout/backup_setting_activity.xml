<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.amz.ios.launcher.views.TopTitlebar
            android:id="@+id/titlebar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            launcher:titleText="@string/setting_backup" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.amz.ios.launcher.views.CustomTextView
                    style="@style/pref_subtitle"
                    android:text="@string/setting_category_backup" />

                <com.amz.ios.launcher.views.IOSPreference
                    android:id="@+id/settings_backup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceSummary="@string/setting_backup_desktop_summary"
                    launcher:preferenceTitle="@string/setting_backup_desktop_title"
                    launcher:rightImage="rightArrow" />

                <include
                    android:id="@+id/settings_default_launcher_gap"
                    layout="@layout/preference_gap" />

                <com.amz.ios.launcher.views.CustomTextView
                    style="@style/pref_subtitle"
                    android:text="@string/setting_category_restore" />

                <com.amz.ios.launcher.views.IOSPreference
                    android:id="@+id/settings_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceSummary="@string/setting_import_desktop_summary"
                    launcher:preferenceTitle="@string/setting_import_desktop_title"
                    launcher:rightImage="rightArrow" />

                <com.amz.ios.launcher.views.IOSPreference
                    android:id="@+id/settings_reset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    launcher:preferenceSummary="@string/setting_reset_desktop_summary"
                    launcher:preferenceTitle="@string/setting_reset_desktop_title"
                    launcher:rightImage="rightArrow" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>