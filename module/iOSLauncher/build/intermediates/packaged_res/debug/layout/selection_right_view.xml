    <ImageView android:id="@+id/img1" android:background="@drawable/quick_access_section_indicator" android:layout_width="@dimen/selection_image_width" android:layout_height="@dimen/selection_image_height" android:rotation="-15"/>
    <ImageView android:id="@+id/img2" android:background="@drawable/quick_access_section_indicator" android:visibility="invisible" android:layout_width="@dimen/selection_image_width" android:layout_height="@dimen/selection_image_height" android:rotation="-45"/>
