<?xml version="1.0" encoding="utf-8"?>
<com.ios.cleanwidget.CleanWidgetView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <com.ios.cleanwidget.CleanIconView
            android:id="@+id/cleanIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:antialias="true"
            android:background="@drawable/clean_icon_circle_bg"
            android:scaleType="fitCenter" />

        <com.amz.ios.launcher.BubbleTextView
            android:id="@+id/widgetName"
            style="@style/Icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:text="@string/clean_widget_name" />

    </LinearLayout>

    <com.ios.cleanwidget.CleanCircleView
        android:id="@+id/cleanCircleView"
        android:layout_width="@dimen/clean_widget_circle_view_size"
        android:layout_height="@dimen/clean_widget_circle_view_size"
        android:layout_gravity="center"
        android:visibility="gone" />

</com.ios.cleanwidget.CleanWidgetView>