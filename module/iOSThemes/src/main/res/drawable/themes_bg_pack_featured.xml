<?xml version="1.0" encoding="utf-8"?>
<!-- Gói xu đầu tiên (Figma): gradient vàng -> cam, viền trắng 1. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:centerColor="#FFDA01"
        android:centerY="0.55"
        android:endColor="#FF9500"
        android:startColor="#FFDA01" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="@color/themes_white" />
</shape>
