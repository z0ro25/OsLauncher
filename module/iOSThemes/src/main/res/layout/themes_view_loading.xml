<?xml version="1.0" encoding="utf-8"?>
<!-- Loading full màn lúc tải + áp theme/icon/nền (LoadingOverlay). clickable để nuốt mọi chạm
     xuống màn bên dưới, kể cả banner. Cùng kiểu fr_loading của màn chọn nền ở :app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/themes_loading_scrim"
    android:clickable="true"
    android:focusable="true">

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

</FrameLayout>
