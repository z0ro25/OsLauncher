<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ Daily Check-in (Figma Rewards): rương vàng tràn lên trên thẻ. Dùng chung màn Rewards và
     dialog check-in hằng ngày; cha phải clipChildren=false + chừa ~40dp phía trên cho rương. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/themes_bg_checkin_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/themes_quicksand_bold"
            android:text="@string/themes_checkin_title"
            android:textColor="@color/themes_text_dark"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/themes_quicksand_medium"
            android:text="@string/themes_checkin_desc"
            android:textColor="#7F7B87"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCheckin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />
    </LinearLayout>

    <ImageView
        android:layout_width="173dp"
        android:layout_height="124dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="-37dp"
        android:importantForAccessibility="no"
        android:src="@drawable/themes_img_chest" />
</FrameLayout>
