<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog thưởng xu (Figma 328x356 bo 16). Dùng cho "Check-in thành công" và "Sau rewarded ads":
     tvRewardSub/tvRewardHint ẩn hiện theo biến thể, xem RewardDialog. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="328dp"
    android:layout_height="wrap_content"
    android:background="@drawable/themes_bg_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="56dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvRewardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/themes_quicksand_bold"
            android:textColor="@color/themes_text_name"
            android:textSize="22sp"
            tools:text="Congratulations!" />

        <TextView
            android:id="@+id/tvRewardSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/themes_quicksand_semibold"
            android:textColor="@color/themes_text_name"
            android:textSize="14sp"
            tools:text="You have earned 10 coins" />

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/themes_ic_coin" />

        <TextView
            android:id="@+id/tvRewardAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/themes_quicksand_bold"
            android:textColor="@color/themes_text_name"
            android:textSize="24sp"
            tools:text="+10 Coins" />

        <TextView
            android:id="@+id/tvRewardHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/themes_quicksand_semibold"
            android:textColor="@color/themes_text_name"
            android:textSize="16sp"
            tools:text="Watch a video to earn 50 coins!" />

        <LinearLayout
            android:id="@+id/btnWatchClaim"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/themes_bg_button_blue"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/themes_ic_rewarded" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:layout_weight="1"
                android:fontFamily="@font/themes_quicksand_bold"
                android:gravity="center"
                android:text="@string/themes_watch_ads_claim"
                android:textColor="@color/themes_white"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/imgRewardClose"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="end"
        android:layout_margin="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/themes_cd_close"
        android:padding="4dp"
        android:src="@drawable/themes_ic_close_circle" />
</FrameLayout>
