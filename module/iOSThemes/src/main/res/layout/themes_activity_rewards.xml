<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/themes_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/themes_view_header" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/themes_screen_padding"
                android:paddingTop="40dp"
                android:paddingBottom="16dp">

                <!-- Daily Check-in: rương vàng tràn lên trên thẻ như Figma. -->
                <include
                    android:id="@+id/checkinCard"
                    layout="@layout/themes_view_checkin_card" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/themes_rewards_suggest"
                    android:textColor="@color/themes_text_dark"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/layoutWatchVideo"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/themes_bg_card16_white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/themes_ic_video" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/themes_watch_video"
                            android:textColor="@color/themes_text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvVideoProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/themes_text_hint"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/themes_bg_pill_pink"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/themes_ic_coin" />

                        <TextView
                            android:id="@+id/tvVideoCoin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/themes_quicksand_bold"
                            android:textColor="@color/themes_white"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/themes_rewards_suggest"
                    android:textColor="@color/themes_text_dark"
                    android:textSize="14sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPacks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <!-- CHỈ ĐỂ TEST API cộng xu (POST /credits), không theo Figma. Gỡ trước khi release. -->
                <Button
                    android:id="@+id/btnTestAddCoin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/themes_test_add_coin" />

                <!-- CHỈ ĐỂ TEST API trừ xu (POST /credits/consume): trừ hết số dư. Gỡ cùng nút trên. -->
                <Button
                    android:id="@+id/btnTestClearCoin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/themes_test_clear_coin" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Tooltip hướng dẫn, mở/đóng bằng nút "?" trên header. -->
    <LinearLayout
        android:id="@+id/layoutTooltip"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/themes_bg_tooltip"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            style="@style/ThemesText.Tooltip"
            android:text="@string/themes_rewards_tip_1" />

        <TextView
            style="@style/ThemesText.Tooltip"
            android:layout_marginTop="6dp"
            android:text="@string/themes_rewards_tip_2" />

        <TextView
            style="@style/ThemesText.Tooltip"
            android:layout_marginTop="6dp"
            android:text="@string/themes_rewards_tip_3" />
    </LinearLayout>
</FrameLayout>
