<?xml version="1.0" encoding="utf-8"?>
<!-- Màn Icon detail (Figma "Unlock icon"): back + badge xu, khung desktop (nền + lưới icon vuốt + dock),
     hàng nút [tim][Unlock with N / Apply][chia sẻ]. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/themes_bg">

    <!-- Nội dung chừa padding đáy = chiều cao SDK báo; frBanner đè lên trên để collapse không đẩy nội dung. -->
    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/themes_screen_padding">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="-4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/themes_cd_back"
            android:padding="4dp"
            android:src="@drawable/themes_ic_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/layoutCoin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/themes_cd_add_coin"
                android:elevation="1dp"
                android:src="@drawable/themes_ic_add_coin" />

            <TextView
                android:id="@+id/tvCoin"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="-4dp"
                android:background="@drawable/themes_bg_coin_count"
                android:fontFamily="@font/themes_quicksand_bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="7dp"
                android:paddingEnd="14dp"
                android:textColor="@color/themes_text_coin"
                android:textSize="14sp"
                tools:text="150" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="-12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/themes_ic_coin" />
        </LinearLayout>
    </LinearLayout>

    <!-- Khung desktop Figma 270x536 bo 30; co theo chiều cao còn lại, giữ tỉ lệ. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="28dp"
        android:paddingBottom="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPreviewBg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/themes_white"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="270:536"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ThemesRoundedImage30" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@id/imgPreviewBg"
            app:layout_constraintEnd_toEndOf="@id/imgPreviewBg"
            app:layout_constraintStart_toStartOf="@id/imgPreviewBg"
            app:layout_constraintTop_toTopOf="@id/imgPreviewBg">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pagerIcons"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/layoutDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/themes_bg_dock"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="12dp" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/themes_screen_padding"
        android:paddingBottom="18dp">

        <FrameLayout
            android:id="@+id/btnFavorite"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/themes_bg_circle_white">

            <ImageView
                android:id="@+id/imgFavorite"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/themes_cd_favorite"
                android:src="@drawable/themes_ic_heart" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/btnAction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:background="@drawable/themes_bg_button_blue_pill"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/themes_white"
                android:textSize="16sp"
                tools:text="Apply" />

            <ImageView
                android:id="@+id/imgActionCoin"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/themes_ic_coin"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnShare"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/themes_bg_circle_white">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/themes_cd_share"
                android:src="@drawable/themes_ic_setting_share" />
        </FrameLayout>
    </LinearLayout>

    </LinearLayout>

    <!-- Banner sát đáy, đè lên main_layout (ẩn khi subs). -->
    <FrameLayout
        android:id="@+id/frBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <include layout="@layout/ads_banner" />
    </FrameLayout>

</FrameLayout>
