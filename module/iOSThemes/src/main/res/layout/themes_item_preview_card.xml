<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ preview theme/wallpaper. Tỉ lệ + bo góc đặt từ code: lớn 158:308 bo 18, suggest 320:690 centerCrop bo 11. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/themes_white"
        android:scaleType="fitXY"
        app:layout_constraintDimensionRatio="320:690"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ThemesRoundedImage18"
        app:strokeColor="@color/themes_card_stroke"
        app:strokeWidth="0.5dp" />


    <ProgressBar
        android:id="@+id/pbImage"
        style="@style/ThemesCardLoading"
        app:layout_constraintBottom_toBottomOf="@id/imgCard"
        app:layout_constraintEnd_toEndOf="@id/imgCard"
        app:layout_constraintStart_toStartOf="@id/imgCard"
        app:layout_constraintTop_toTopOf="@id/imgCard" />

    <TextView
        android:id="@+id/tvNew"
        style="@style/ThemesNewBadge"
        android:background="@drawable/themes_bg_new_badge_18"
        app:layout_constraintStart_toStartOf="@id/imgCard"
        app:layout_constraintTop_toTopOf="@id/imgCard" />

</androidx.constraintlayout.widget.ConstraintLayout>
