<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="themes_text_dark">#111111</color>
    <color name="themes_text_name">#212121</color>

    <!-- Figma Mine: thẻ lớn 158x308 bo 17.8, thẻ suggest 102x196 bo 11.4, icon 40dp bo 6. -->
    <style name="ThemesRoundedImage11">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">11dp</item>
    </style>

    <style name="ThemesRoundedImage12">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ThemesRoundedTop16">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemesDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="ThemesRoundedImage6">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
