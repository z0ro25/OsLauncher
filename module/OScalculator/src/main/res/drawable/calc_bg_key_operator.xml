<?xml version="1.0" encoding="utf-8"?>
<!-- state_selected = toán tử đang chờ số thứ hai (giống iOS: nút sáng lên). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/calc_key_operator_pressed" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/calc_text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/calc_key_operator" />
        </shape>
    </item>
</selector>
