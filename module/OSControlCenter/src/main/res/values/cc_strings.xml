    <!-- Permissions -->
    <string name="cc_permissions">Permissions</string>
    <string name="cc_permissions_desc">These are the essential permissions required for Launcher MiOS to function normally</string>
    <string name="cc_perm_accessibility">Accessibility Service</string>
    <string name="cc_perm_accessibility_desc">Show Control Center over other apps</string>
    <string name="cc_perm_battery">Battery Optimization</string>
    <string name="cc_perm_battery_desc">Keep app working in background</string>
    <string name="cc_perm_notification">Notification Access</string>
    <string name="cc_perm_notification_desc">Control music player and show notifications</string>
    <string name="cc_guide_notification">Allow Launcher MiOS to control music player</string>
    <string name="cc_accessibility_service_label">Launcher MiOS Control Center</string>
    <string name="cc_accessibility_service_desc">Launcher MiOS uses the Accessibility Service only to display Control Center and Notification Center over other apps when you swipe from the screen edge. It does not read, collect or share any screen content or personal data. Touches on the swipe area that are not a swipe are passed through to the app below.</string>

    <!-- Hộp giải thích Accessibility (Google Play bắt buộc) -->
    <string name="cc_disclosure_title">Use Accessibility Service</string>
    <string name="cc_disclosure_message">To show Control Center and Notification Center on top of other apps, Launcher MiOS needs the Accessibility Service permission.\n\n• It is only used to draw the panels when you swipe from the screen edge.\n• Launcher MiOS does not read, collect or share any screen content or personal data.\n• Taps on the thin swipe area are passed through to the app below, so it never blocks your apps.\n\nOn the next screen, find \"Launcher MiOS Control Center\" and turn it on.</string>
    <string name="cc_disclosure_agree">Agree</string>
    <string name="cc_disclosure_deny">Not now</string>

