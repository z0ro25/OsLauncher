<?xml version="1.0" encoding="utf-8"?>
<!-- Vẽ overlay + phát lại chạm rơi vào thanh kéo xuống app bên dưới (canPerformGestures).
     Không đọc nội dung cửa sổ; không khai isAccessibilityTool (chính sách Google Play). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/cc_accessibility_service_desc"
    android:notificationTimeout="1000"
    android:packageNames="com.ezla.oslauncher.controlcenter.none" />
