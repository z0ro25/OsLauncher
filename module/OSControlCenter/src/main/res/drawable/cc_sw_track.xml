<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <size android:width="64dp" android:height="28dp" />
            <corners android:radius="100dp" />
            <solid android:color="@color/cc_green" />
        </shape>
    </item>
    <item>
        <shape>
            <size android:width="64dp" android:height="28dp" />
            <corners android:radius="100dp" />
            <solid android:color="@color/cc_switch_off" />
        </shape>
    </item>
</selector>
