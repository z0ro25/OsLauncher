<?xml version="1.0" encoding="utf-8"?>
<!-- Hộp chọn màu (Figma "Color setting" 52:238664, 279dp): SV, Hue, Alpha, ô nhập hex/rgba, 16 màu mẫu. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="279dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/cc_bg_dialog"
        android:orientation="vertical"
        android:padding="12dp">

        <com.ezla.oslauncher.controlcenter.widget.CcSatValView
            android:id="@+id/satVal"
            android:layout_width="match_parent"
            android:layout_height="190dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.ezla.oslauncher.controlcenter.widget.CcColorBarView
                    android:id="@+id/hueBar"
                    android:layout_width="match_parent"
                    android:layout_height="13dp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.ezla.oslauncher.controlcenter.widget.CcColorBarView
                    android:id="@+id/alphaBar"
                    android:layout_width="match_parent"
                    android:layout_height="13dp" />
            </LinearLayout>

            <View
                android:id="@+id/preview"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/cc_bg_color_preview" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etHex"
                android:layout_width="75dp"
                android:layout_height="25dp"
                android:background="@drawable/cc_bg_input"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textCapCharacters"
                android:maxLength="9"
                android:padding="0dp"
                android:textColor="#000000"
                android:textSize="13sp"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/etR"
                style="@style/CcColorInput"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/etG"
                style="@style/CcColorInput"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/etB"
                style="@style/CcColorInput"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/etA"
                style="@style/CcColorInput"
                tools:ignore="LabelFor" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/CcColorInputLabel"
                android:layout_width="75dp"
                android:layout_marginStart="0dp"
                android:layout_weight="0"
                android:text="hex"
                tools:ignore="HardcodedText" />

            <TextView
                style="@style/CcColorInputLabel"
                android:text="r"
                tools:ignore="HardcodedText" />

            <TextView
                style="@style/CcColorInputLabel"
                android:text="g"
                tools:ignore="HardcodedText" />

            <TextView
                style="@style/CcColorInputLabel"
                android:text="b"
                tools:ignore="HardcodedText" />

            <TextView
                style="@style/CcColorInputLabel"
                android:text="a"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#EEEEEE" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSwatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/cc_bg_pill_gray"
                android:gravity="center"
                android:text="@string/cc_cancel"
                android:textColor="@color/cc_dialog_cancel_text"
                android:textSize="14sp" />

            <Space
                android:layout_width="9dp"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/btnApply"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/cc_bg_pill_blue"
                android:gravity="center"
                android:text="@string/cc_apply"
                android:textColor="@color/cc_white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
