<?xml version="1.0" encoding="utf-8"?>
<!-- 1 ô trong sheet thêm tiện ích (Figma "App Name" 65x83): ô tròn kính 65dp + tên 12sp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/cc_tile"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical">

    <com.ezla.oslauncher.controlcenter.widget.CcTileView
        android:id="@+id/ccTile"
        android:layout_width="@dimen/cc_tile"
        android:layout_height="@dimen/cc_tile" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/appbase_sf_pro_regular"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/cc_white"
        android:textSize="12sp" />
</LinearLayout>
