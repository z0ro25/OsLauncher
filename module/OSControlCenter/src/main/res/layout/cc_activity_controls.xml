<?xml version="1.0" encoding="utf-8"?>
<!-- Màn Custom Controls (Figma 52:237670 / music / Network): panel thật ở chế độ sửa trên nền wallpaper. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/vScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cc_panel_scrim" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/pageDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/dot0"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:padding="1dp"
            android:src="@drawable/cc_ic_page_fav" />

        <ImageView
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="34dp"
            android:importantForAccessibility="no"
            android:padding="1dp"
            android:src="@drawable/cc_ic_page_music" />

        <ImageView
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="34dp"
            android:importantForAccessibility="no"
            android:padding="1dp"
            android:src="@drawable/cc_ic_page_cell" />
    </LinearLayout>

    <include
        android:id="@+id/header"
        layout="@layout/cc_view_header" />
</FrameLayout>
