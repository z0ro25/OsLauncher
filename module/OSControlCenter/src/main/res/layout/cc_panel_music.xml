<?xml version="1.0" encoding="utf-8"?>
<!-- Trang Nhạc (Figma "Screen Control Center/Music"): thẻ kính 300dp, ảnh bìa lớn + điều khiển. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/cc_panel_width"
    android:layout_height="wrap_content"
    android:background="@drawable/cc_bg_tile_big"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ccMusicArt"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="@color/cc_chip_off"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CcRound12" />

    <TextView
        android:id="@+id/ccMusicApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/appbase_sf_pro_regular"
        android:maxLines="1"
        android:textColor="@color/cc_white_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/ccMusicTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/appbase_sf_pro_medium"
        android:maxLines="1"
        android:text="@string/cc_not_playing"
        android:textColor="@color/cc_white"
        android:textSize="16sp" />

    <SeekBar
        android:id="@+id/ccMusicProgress"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:background="@null"
        android:max="1000"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:progressDrawable="@drawable/cc_bg_progress"
        android:splitTrack="false"
        android:thumb="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ccMusicPos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="@color/cc_white_secondary"
            android:textSize="11sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/ccMusicDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/cc_white_secondary"
            android:textSize="11sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ccMusicPrev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cc_track"
            android:padding="12dp"
            android:src="@drawable/cc_ic_prev" />

        <ImageView
            android:id="@+id/ccMusicPlay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cc_track"
            android:padding="8dp"
            android:src="@drawable/cc_ic_play" />

        <ImageView
            android:id="@+id/ccMusicNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/cc_track"
            android:padding="12dp"
            android:src="@drawable/cc_ic_next" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/cc_ic_vol_low" />

        <SeekBar
            android:id="@+id/ccMusicVolume"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:max="100"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressDrawable="@drawable/cc_bg_progress"
            android:splitTrack="false"
            android:thumb="@null" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/cc_ic_vol_high" />
    </LinearLayout>
</LinearLayout>
