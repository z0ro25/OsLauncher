<?xml version="1.0" encoding="utf-8"?>
<!-- Sheet chọn ô để thêm (Figma chưa có frame: dựng theo style màn cài đặt, user đã đồng ý). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cc_bg_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/cc_bg_pill_gray" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/appbase_sf_pro_semibold"
        android:gravity="center"
        android:text="@string/cc_add_control"
        android:textColor="@color/cc_title"
        android:textSize="17sp" />

    <LinearLayout
        style="@style/CcCard"
        android:layout_marginTop="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/cc_controls_all_added"
        android:textColor="@color/cc_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
