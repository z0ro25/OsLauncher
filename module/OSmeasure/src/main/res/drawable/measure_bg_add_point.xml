<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Add Point": vòng trắng 80dp viền 4dp, lõi trắng 64dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="@color/measure_white" />
        </shape>
    </item>
    <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/measure_white" />
        </shape>
    </item>
</layer-list>
