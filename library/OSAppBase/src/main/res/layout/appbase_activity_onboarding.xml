<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appbase_onboarding_bg">

    <!-- Ảnh + gradient + tiêu đề nằm trong từng trang để vuốt cùng nhau. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpOnboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/frAds"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Hàng dot + Next đè lên đáy gradient của trang (Figma: cách khối ads 8dp). -->
    <LinearLayout
        android:id="@+id/layoutControl"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/appbase_onboarding_padding"
        app:layout_constraintBottom_toTopOf="@id/frAds"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
            android:id="@+id/dotIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:dotsColor="@color/appbase_onboarding_dot"
            app:dotsCornerRadius="3dp"
            app:dotsSize="6dp"
            app:dotsSpacing="1.5dp"
            app:dotsWidthFactor="3"
            app:selectedDotColor="@color/appbase_onboarding_accent" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/appbase_quicksand_semibold"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:text="@string/appbase_onboarding_next"
            android:textColor="@color/appbase_onboarding_accent"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Native onb mỗi trang (Figma 300dp). Không có ad thì INVISIBLE (không GONE) để giữ chỗ:
         pager không giãn xuống nên ảnh không bị kéo. -->
    <FrameLayout
        android:id="@+id/frAds"
        android:layout_width="0dp"
        android:layout_height="@dimen/appbase_onboarding_ad_height"
        android:background="@color/appbase_ad_placeholder"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
