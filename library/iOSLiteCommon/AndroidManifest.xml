<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    >

<!--    <uses-sdk-->
<!--        android:minSdkVersion="16"-->
<!--        android:targetSdkVersion="21" />-->


    <application>

        <!--  应用使用统计 -->
        <!-- Provider này lưu LỊCH SỬ DÙNG APP của người dùng (mở bao nhiêu lần, lần cuối là khi nào)
             trong DB không mã hoá, và bản thân nó KHÔNG có dòng kiểm tra caller nào ở
             query/insert/update/delete -> để exported="true" là app bất kỳ đọc/ghi/xoá được.

             Bất biến cần giữ: chỉ AppUsagesModel (module/iOSLauncher) dùng provider này, cùng APK
             nên cùng UID. ContentProvider không export vẫn cho cùng UID truy cập -> exported="false"
             không ảnh hưởng chức năng đếm lượt dùng app. -->
        <provider
            android:name=".provider.AppUsagesProvider"
            android:authorities="com.ezt.ios.ioslite.provider.usages"
            android:exported="false" />

        <!--  全局设置 -->
        <provider
            android:name=".setting.SettingProvider"
            android:authorities="com.truongnt.ios.ioslite.common.setting"
            android:exported="true" />

        <!-- 内存监测 -->
        <activity
            android:exported="true"
            android:name=".debug.MemoryDumpActivity"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 内存监测服务 -->
        <service android:name=".debug.MemoryTracker" />

        <receiver android:exported="true" android:name=".downloadapk.ApkReceiver" >
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

    </application>
</manifest>