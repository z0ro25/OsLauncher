    <application>

        <!--  应用使用统计 -->
        <provider
            android:name=".provider.AppUsagesProvider"
            android:authorities="com.amz.ios.ioslite.provider.usages"
            android:exported="true" />

        <!--  全局设置 -->
        <provider
            android:name=".setting.SettingProvider"
            android:authorities="com.amz.ios.ioslite.common.setting"
            android:exported="true" />

        <!-- 内存监测 -->
        <activity
            android:exported="true"
            android:name=".debug.MemoryDumpActivity"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 内存监测服务 -->
        <service android:name=".debug.MemoryTracker" />

        <receiver android:exported="true" android:name=".downloadapk.ApkReceiver" >
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>
</manifest>