<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 功能配置文件 -->

    <!-- 注：
       ××××××××××××××××××××××××××××××××××××××××××××××××××××××××××××
       优先级  客户配置文件 > 主工程配置文件 >  common模块配置文件
       ××××××××××××××××××××××××××××××××××××××××××××××××××××××××××××
    -->


    <!--  ××××××××××××××××××××××××××××  桌面风格  ××××××××××××××××××××××××××××  -->

    <!--  主题的默认包名  -->
    <string name="def_apply_theme_package">com.ios.ioslite.global</string>

    <!--  桌面字体颜色 , 默认白色 -->
    <color name="def_workspace_label_color">#FFFFFFFF</color>
    <!--桌面滑动阀值-->
    <string name="def_launcher_significant_move_threshold">0.4</string>

    <!--  桌面行列数 （ 行 × 列）
        -1: 自适应
        0: 4 x 4
        1: 5 x 4
        2: 4 x 5
        3: 5 x 5-->
    <integer name="def_grid_rows_columns">1</integer>


    <!-- def_grid_icon_custom_enable 为true时，自定义图标文字大小生效，
         包含： def_grid_icon_size
               def_grid_label_size
               def_hotseat_icon_size
         false : 则自适应屏幕
     -->
    <bool name="def_grid_icon_custom_enable">true</bool>

    <!-- 桌面应用图标大小 -->
    <dimen name="def_grid_icon_size">54dp</dimen>
    <!-- 桌面应用名称大小 -->
    <dimen name="def_grid_label_size">14dp</dimen>
    <!--hotseat区是否显示名称-->
    <bool name="def_hotseat_label_show_enable">true</bool>
    <!--hotseat区是否强制显示名称，navigationbar的弹出与否，将无法影响该属性的值，默认配置false,**主要针对navigationbar固定的情况,如果navigationbar不固定，此属性直接置为false**-->
    <bool name="def_hotseat_label_forced_show">false</bool>

    <!-- 滑动效果
         none：无
         stack：卡片堆
         accordion：手风琴
         cube-in：向内立方体
         cube-out：向外立方体
         overview：概览
         cross：交叉
         flip：垂直翻转
         rotate-up：风车
         rotate-down：轮子
         carousel-left：旋转木马(左)
         carousel-right：旋转木马(右)     -->
    <string name="def_workspace_scroll_effect">none</string>

    <!--
    none
    random
    heart
    stars
    heartbeat
    halo
    -->
    <string name="def_workspace_magic_thumb">none</string>

    <!-- 桌面应用切换动画
     0:  系统
     1:  左滑动
     2:  右滑动
     3:  上滑动
     4:  下滑动
     5:  缩放
     6:  旋转    -->
    <integer name="def_pending_anim_style">1</integer>

    <!-- 桌面图标未读信息角标显示 -->
    <bool name="feature_icon_unread_support">true</bool>

    <!--  OTA2  -->
    <bool name="feature_ota2_enable">false</bool>

    <!--  桌面加载动画  -->
    <bool name="def_launcher_loading_view_enable">true</bool>

    <!-- 桌面风格切换 -->
    <bool name="feature_desktop_style_change_enable">true</bool>

    <!-- 桌面手势 -->
    <bool name="feature_desktop_gesture_enable">true</bool>

    <!--文件夹探索-->
    <bool name="feature_ios_discovery_enable">false</bool>
    <!--从apk获取背景图标-->
    <bool name="def_use_icon_in_apk_enable">false</bool>

    <!--桌面应用打开动画-->
    <bool name="feature_desktop_trans_anim_enable">true</bool>

    <!-- 用户向导动画 -->
    <bool name="def_user_guide_enable">false</bool>

    <!--  使用系统默认壁纸作为默认主题壁纸  -->
    <bool name="def_use_system_default_wallpaper">false</bool>

    <!-- 桌面布局行列切换 -->
    <!--<bool name="feature_desktop_grid_change_enable">false</bool>-->
    <bool name="feature_desktop_grid_change_enable">true</bool>

    <!-- 删除应用后,桌面图标自动对齐 -->
    <bool name="def_desktop_auto_align_enable">false</bool>

    <!-- 壁纸滑动是否开启 -->
    <bool name="def_wallpaper_scroll_enabled">true</bool>

    <bool name="def_news_page_switch_enabled">false</bool>

    <!-- default launcher database version -->
    <integer name="def_launcher_db_version">9</integer>

    <!-- default launcher iconcahe version -->
    <!-- v16: đồng bộ với IconCache.IconDB.DB_VERSION. Partner config này GHI ĐÈ hằng số trong
         code (IconCache.java:168), nên phải bump ở đây icon cache mới thực sự rebuild -> logo
         iOS mới (Gmail/Maps/News/TV/Wallet/Meet) hiển thị thay logo gốc đã cache.
         v17: gỡ gm/apps.maps/videos/apps.tachyon khỏi def_cts_app_list -> 4 app này thôi bị
         CTS chặn; bump để xoá blob logo gốc đã cache, vẽ lại bằng ic_app_gmail/maps/gtv/gmeet.
         v18: gỡ apps.photos khỏi CTS (Photos->ic_app_gallery) + thêm Keep vào app_note
         (Keep->ic_app_note). Bump để xoá blob chong chóng Google Photos, dựng lại logo iOS. -->
    <integer name="def_iconcache_db_version">18</integer>

    <!-- default launcher setting version -->
    <integer name="def_setting_db_version">5</integer>

    <!-- default launcher weather version -->
    <integer name="def_weather_db_version">5</integer>

    <!-- desktop loop -->
    <bool name="feature_desktop_loop_enable">true</bool>
    <bool name="def_desktop_loop_enable">false</bool>

    <!--sleep mode-->
    <bool name="def_sleep_mode_enable">true</bool>

    <!-- sort icon -->
    <bool name="feature_sort_icon_enable">false</bool>

    <bool name="feature_new_install_icon_enable">true</bool>

    <!-- ××××××××××××××××××××××××××××  AllApps  ××××××××××××××××××××××××××××  -->

    <!-- 是否启用AllApp, 进入双层桌面 -->
