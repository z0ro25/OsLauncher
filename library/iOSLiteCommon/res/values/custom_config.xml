    <!-- ××××××××××××××美化中心锁屏版本,根据系统不同版本设置不同的锁屏版本，可设置为v600,v700××××××××××××  -->
    <string name="feature_lock_screen_version">v700</string>

    <bool name="feature_set_as_default_theme_enable">false</bool>
    <!-- ××××××××××××××××××××××××××××  应用分类   ××××××××××××××××××××××××××××  -->
    <!-- 默认布局分类 -->
    <bool name="def_category_default_layout">false</bool>
    <!-- 新安装应用自动分类 -->
    <bool name="def_category_new_apps">false</bool>
    <bool name="feature_category_new_apps_enable">true</bool>

    <!-- ××××××××××××××××××××××××××××  桌面设置   ××××××××××××××××××××××××××××  -->
    <!-- 检查更新 -->
    <bool name="feature_check_update_support">true</bool>
    <!-- 用户推荐 -->
    <bool name="feature_sw_share_support">true</bool>
    <!--是否懒加载新闻页-->
    <bool name="def_desktop_lazy_load_newspager_enable">true</bool>

    <bool name="feature_drop_info_enable">false</bool>

    <bool name="feature_drop_uninstall_enable">true</bool>

    <bool name="feature_drop_unavailable_enable">false</bool>
    <bool name="feature_desktop_effect_enable">true</bool>

    <bool name="feature_delete_effect_enable">true</bool>

    <!-- ××××××××××××××××××××××××××××  快捷方式 , 小部件  ××××××××××××××××××××××××××××  -->
    <bool name="feature_install_shortcut_enable">true</bool>
    <string-array name="def_widget_black_list" translatable="false">
        <item>com.ios.biglauncher</item>
    </string-array>
    <string-array name="def_shortcut_black_list" translatable="false"></string-array>
    <!-- CTS = "keep the app's own icon, never re-skin". isCtsApp() is the first gate in
         IconCache.getThemeIconForAppComp, so anything here bypasses the iOS theme icon.
         Chrome (com.android.chrome) and Play Store (com.android.vending) were removed so the
         iOS override applies: Chrome -> ic_app_browser (Safari), Play -> ic_app_market
         (App Store), per app_target_app_browser.xml / app_target_app_market.xml classification.
         Gỡ tiếp gm/apps.maps/videos/apps.tachyon để 4 app này nhận logo iOS mới
         (Gmail->ic_app_gmail, Maps->ic_app_maps, Google TV->ic_app_gtv, Meet->ic_app_gmeet).
         Trước đó chúng bị CTS chặn nên giữ logo gốc dù đã có app-type + drawable.
         Gỡ tiếp apps.photos để Google Photos nhận ic_app_gallery (bông hoa iOS Photos);
         app-type app_gallery đã map sẵn package này, chỉ bị CTS chặn re-skin. -->
    <string-array name="def_cts_app_list" translatable="false">
        <item>com.google.android.googlequicksearchbox</item>
        <item>com.google.android.music</item>
        <item>com.google.android.apps.docs</item>
        <item>com.google.android.youtube</item>
    </string-array>
    <string-array name="def_hide_app_list" translatable="false"></string-array>
    <string-array name="def_not_uninstall_app_list" translatable="false">
        <item>com.baidu.searchbox</item>
    </string-array>

    <!--天气是否在数据流量打开时自动定位，true自动定位，false不自动定位，否认false-->
    <bool name="feature_start_location_when_mobile_data_open">true</bool>

