<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="IOSLoadingView">
        <item name="minWidth">48dip</item>
        <item name="maxWidth">48dip</item>
        <item name="minHeight">48dip</item>
        <item name="maxHeight">48dip</item>
        <item name="indicatorType">BallPaulseIndicator</item>
    </style>


    <style name="PrefSettingsBase" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/pref_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="PrefSettings" parent="PrefSettingsBase">
        <item name="android:statusBarColor">@color/white</item>
    </style>

    <style name="PrefSettings.Immerse" parent="PrefSettings"></style>

    <style name="PrefSettings.Wallpaper" parent="PrefSettings">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>

    <style name="pref_subtitle">
        <item name="android:textSize">14.0sp</item>
        <item name="android:textColor">@color/pref_category_green</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingLeft">16.0dip</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">36.0dip</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="pref_settingtitle">
        <item name="android:textSize">14.0sp</item>
        <item name="android:textColor">@color/ios_gray1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:paddingLeft">16.0dip</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">36.0dip</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="AdTopic">
        <item name="android:background">@drawable/ad_topic_item_bg</item>
    </style>

    <style name="ADCardName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#494b4c</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!--<style name="ADRatingBar" parent="@android:attr/ratingBarStyleSmall">-->
        <!--<item name="android:progressDrawable">@drawable/ad_rating_bar_drawable</item>-->
    <!--</style>-->

    <style name="ADDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#a2a2a2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ADCardFreeBtn">
        <item name="android:background">@drawable/ad_toolbox_card_btn_normal_bg</item>
        <item name="android:textColor">@android:color/background_light</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
    </style>

    <!--
      Theme cho dialog native full của InterNativeFull.

      Vì sao cần theme riêng: Dialog tạo bằng theme mặc định là cửa sổ NỔI (windowIsFloating=true)
      -> có margin quanh viền, không bao giờ chiếm trọn màn. `windowIsFloating=false` mới biến nó
      thành cửa sổ toàn màn hình. Ngoài ra tắt dim nền và bỏ lớp overlay mặc định để nền trắng
      của layout phủ kín, không lộ viền hệ thống.

      Nền để TRẮNG vì layout native đổ vào trong vẽ chữ bằng @color/black.

      Tham chiếu Theme.AppCompat... giống style PrefSettingsBase ở trên — library đã có
      appcompat trong dependency nên resolve được.
    -->
    <style name="AdsFullScreenDialog" parent="@style/Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>