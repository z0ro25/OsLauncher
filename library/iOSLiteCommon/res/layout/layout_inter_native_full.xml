<?xml version="1.0" encoding="utf-8"?><!--
  Nội dung dialog toàn màn hình của cặp inter + native (InterNativeFull).

  Vai trò: làm VIEW CHA hứng layout native. FSDAds tự inflate layout của nó (mặc định
  layout_native_full) vào inter_native_full_ad_container; nút X do màn này tự quản và
  InterNativeFull gắn sự kiện đóng dialog vào đó.

  Vì sao nền phải SÁNG: layout native đổ vào đây vẽ chữ bằng @color/black — nền tối sẽ
  làm chữ vô hình.

  Nút X: dùng ImageView thường (không bo góc, không CardView) theo quy ước UI của dự án.
  ?android:attr/selectableItemBackgroundBorderless là attr của framework (API 21+), không
  phải attr của AppCompat — cần vậy vì dialog có thể được mở từ Activity trần của desktop
  launcher, không có theme AppCompat.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inter_native_full_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <FrameLayout
        android:id="@+id/inter_native_full_ad_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="afterDescendants" />

    <ImageView
        android:id="@+id/inter_native_full_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ads_native_full_close"
        android:padding="10dp"
        android:src="@drawable/ad_ic_close" />
</FrameLayout>
