<?xml version="1.0" encoding="utf-8"?>
<!--
  Thân notification khi MỞ RỘNG. Cùng ràng buộc với bản thu gọn: hệ thống tự vẽ header, và
  RemoteViews không nhận ConstraintLayout/ShapeableImageView nên ảnh bo góc sẵn trong bitmap.
  Nút bám phải theo mock; nền bo tròn lấy từ bg_daily_noti_btn.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="16dp"
    android:paddingTop="2dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDailyNotiIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- TextAppearance.Compat.Notification.* (androidx.core) tự chọn màu chữ theo nền noti
                 sáng/tối; hardcode màu hoặc ?android:attr sẽ mất chữ trên một số OEM. -->
            <TextView
                android:id="@+id/tvDailyNotiTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDailyNotiText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="4"
                android:textAppearance="@style/TextAppearance.Compat.Notification" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvDailyNotiAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_daily_noti_btn"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="@string/daily_noti_action"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
