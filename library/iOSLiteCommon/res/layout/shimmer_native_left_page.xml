<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton của layout_native_left_page: cùng khung/padding/vị trí khối để lúc ad vào không giật. -->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_native_inline_card"
    app:shimmer_auto_start="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <View
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_native_shimmer_block" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_native_shimmer_block"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="H,20:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="280dp"
                app:layout_constraintHeight_min="120dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_native_shimmer_block" />

            <View
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_weight="1"
                android:background="@drawable/bg_native_shimmer_block" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_native_shimmer_block" />

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_native_shimmer_block" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
