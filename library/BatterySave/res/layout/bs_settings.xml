<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bs_line" >

    <com.zhuoyi.security.batterysave.views.BS_TitleBar
        android:id="@id/bs_settings_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bs_title_height"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:background="@drawable/bs_listview_item"
        app:centerTitle="@string/bs_switcher"
        app:centerTitleColor="@color/bs_switcher"
        app:centerTitleSize="@dimen/bs_Bar_text_size"
        app:showCenterTitle="true"
        app:showLeftIcon="true" />

    <ImageView
        android:id="@id/bs_settings_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bs_line_height"
        android:layout_below="@id/bs_settings_bar"
        android:background="@drawable/bs_line" />

    <ListView
        android:id="@id/bs_switcher_settings_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bs_settings_line"
        android:divider="@null"
        android:scrollbars="none"
        android:background="@drawable/bs_listview_item">
    </ListView>

</RelativeLayout>