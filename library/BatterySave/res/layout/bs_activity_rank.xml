<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    android:background="@color/bs_line">

    <com.zhuoyi.security.batterysave.views.BS_TitleBar
        android:id="@+id/rank_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bs_Bar_height"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:background="@drawable/bs_listview_item"
        app:centerTitle="@string/bs_Bar_Rank_Middle"
        app:centerTitleColor="@color/bs_Rank_TextColor"
        app:centerTitleSize="@dimen/bs_Bar_text_size"
        app:showCenterTitle="true"
        app:showLeftIcon="true" />

    <ImageView
        android:id="@+id/bs_divider_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bs_line_height"
        android:layout_below="@id/rank_bar"
        android:background="@drawable/bs_line" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bs_divider_top"
        android:divider="@null"
        android:scrollbars="none"
        android:background="@drawable/bs_listview_item"/>


</RelativeLayout>
