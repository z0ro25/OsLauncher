<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/bs_ripple_material_light">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/bs_ripple_material_light" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape>

            <gradient android:angle="270" android:endColor="#00000000" android:startColor="#00000000" />

            <stroke android:width="1sp" android:color="@color/bs_ripple_material_light" />

            <corners android:radius="6px" />

            <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape>
    </item>
</ripple>

