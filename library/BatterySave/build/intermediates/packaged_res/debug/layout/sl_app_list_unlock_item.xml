<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/sl_show_unlock_item"
    android:layout_width="match_parent"
    android:minHeight="@dimen/sl_listview_height"
    android:background="@drawable/bs_listview_item_bg" >

    <ImageView
        android:id="@id/sl_unlock_icon"
        android:layout_width="@dimen/sl_icon_size"
        android:layout_height="@dimen/sl_icon_size"
        android:layout_marginLeft="@dimen/sl_space_layout"
        android:layout_centerVertical="true" />

    <TextView
        android:id="@id/sl_unlock_appname"
        style="@style/sl_common_ListItemNameStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@id/sl_unlock_icon"
        android:layout_marginLeft="@dimen/sl_space_layout" />

    <ImageView
        android:id="@id/sl_show_unlock_item_cbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_marginRight="@dimen/sl_space_layout"
        android:layout_centerVertical="true"
        android:src="@drawable/sl_list_button_unlock_default" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/bs_line_height"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/sl_space_layout"
        android:background="@drawable/bs_line" />

</RelativeLayout>