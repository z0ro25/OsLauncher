<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sl_background_color"
    android:fitsSystemWindows="true"
    android:orientation="vertical" >

       <com.zhuoyi.security.batterysave.views.SL_TitleBar
            xmlns:tb="http://schemas.android.com/apk/res-auto"
            android:id="@id/sl_lock_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tb:slcenterTitle="@string/sl_security_item_hint2"
            tb:slshowLeftIcon="true"
            tb:slshowRightIcon="true" />
       
    <RelativeLayout
        android:layout_below="@id/sl_lock_title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f8f8f8"
        android:orientation="vertical" >

        <ListView
            android:id="@id/sl_lock_listview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:background="@drawable/bs_listview_item"
            android:scrollbars="none" >
        </ListView>

        <ImageView
            android:id="@id/sl_ok_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/sl_add_margin"
            android:layout_centerHorizontal="true"
            android:src="@drawable/sl_add_lock_app" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@id/sl_temp_lock"
        android:layout_below="@id/sl_lock_title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sl_background_color"
        android:orientation="vertical" >

        <com.zhuoyi.security.batterysave.views.SL_ScaleView
            android:id="@id/sl_add_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:onClick="viewClick"
            android:src="@drawable/sl_lock_temp_add" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/sl_add_app"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10.5dip"
            android:text="@string/sl_lock_temp_addapp"
            android:textColor="@android:color/white"
            android:textSize="17.16sp" />
    </RelativeLayout>

</RelativeLayout>