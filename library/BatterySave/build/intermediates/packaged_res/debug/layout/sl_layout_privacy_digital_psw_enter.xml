<?xml version="1.0" encoding="utf-8"?>
<com.zhuoyi.security.batterysave.views.SL_FloatView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sl_background_color"
    android:orientation="vertical" >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@id/sl_finger_lay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/sl_finger_print_margin_top"
            android:orientation="horizontal"
            android:visibility="gone" >

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@drawable/sl_finger_icon" />

            <TextView
                android:id="@id/sl_finger_print_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="@dimen/sl_finger_tv_margin_left"
                android:text="@string/sl_finger_print_lock_screen_tv"
                android:textColor="@color/sl_white" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@id/sl_et_lockview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/sl_pwd_top"
        android:text="@string/sl_enter_psw_16"
        android:textColor="@color/sl_white"
        android:textSize="@dimen/sl_pwd_size" />

    <EditText
        android:id="@id/sl_et_lockview_pwd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/sl_et_lockview"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/sl_pwd_margin_top"
        android:background="@null"
        android:editable="false"
        android:lineSpacingExtra="@dimen/sl_space_pwd"
        android:maxLength="6"
        android:password="true"
        android:singleLine="true"
        android:textColor="@color/sl_white"
        android:textSize="@dimen/sl_pwd_ed" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/sl_lock_num_bottom"
        android:orientation="vertical" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/sl_num_height"
            android:orientation="horizontal" >

            <ImageButton
                android:id="@id/sl_num1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_num1" />

            <ImageButton
                android:id="@id/sl_num2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_num2" />

            <ImageButton
                android:id="@id/sl_num3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_num3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/sl_num_height"
            android:orientation="horizontal" >

            <ImageButton
                android:id="@id/sl_num4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_num4" />

            <ImageButton
                android:id="@id/sl_num5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_num5" />

            <ImageButton
                android:id="@id/sl_num6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_num6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/sl_num_height"
            android:orientation="horizontal" >

            <ImageButton
                android:id="@id/sl_num7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_num7" />

            <ImageButton
                android:id="@id/sl_num8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_num8" />

            <ImageButton
                android:id="@id/sl_num9"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_num9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/sl_num_height"
            android:orientation="horizontal" >

            <ImageButton
                android:id="@id/sl_num_reinput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_numc" />

            <ImageButton
                android:id="@id/sl_num0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_num0" />

            <ImageButton
                android:id="@id/sl_num_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:background="@drawable/sl_img_btn_bg"
                android:src="@drawable/sl_button_delete" />
        </LinearLayout>
    </LinearLayout>
</com.zhuoyi.security.batterysave.views.SL_FloatView>