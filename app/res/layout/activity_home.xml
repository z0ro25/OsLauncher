<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onb_bg"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/sf_pro_display_bold"
        android:text="@string/app_name_launcher"
        android:textColor="@color/onb_text_primary"
        android:textSize="28sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===================== Go to launcher (đi tới desktop + finish app) ===================== -->
            <LinearLayout
                android:id="@+id/ll_go_to_launcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_lang_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home_go_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_medium"
                        android:text="@string/go_to_launcher"
                        android:includeFontPadding="false"
                        android:textColor="@color/onb_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:text="@string/explore_your_os_interface_on_device"
                        android:textColor="@color/onb_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home_arrow_right" />
            </LinearLayout>

            <!-- ===================== Set as default launcher (Figma 246-6116) — nút "Set default" xanh mở dialog chọn launcher mặc định ===================== -->
            <LinearLayout
                android:id="@+id/ll_set_default_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_lang_card"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:includeFontPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/set_as_default_launcher"
                        android:textColor="@color/onb_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:text="@string/set_default_launcher_card_desc"
                        android:textColor="@color/onb_text_secondary"
                        android:textSize="12sp" />

                    <!-- Nút pill "Set default" (194x30 theo Figma) — bấm để mở chọn launcher mặc định -->
                    <TextView
                        android:id="@+id/btn_set_default"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/home_btn_set_default"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/set_default"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_card_select_launcher" />
            </LinearLayout>

            <!-- ===================== Card chính (12 mục) ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lang_card"
                android:orientation="vertical">


                <!-- General -->
                <LinearLayout
                    android:id="@+id/ll_general"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_general" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/general" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Change App Icon -->
                <LinearLayout
                    android:id="@+id/ll_change_app_icon"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_app_icon" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/change_app_icon" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Homescreen Style -->
                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/ll_homescreen_style"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_homescreen" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/homescreen_style" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Screen Grid -->
                <LinearLayout
                    android:id="@+id/ll_screen_grid"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_grid" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/screen_grid" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Hidden Apps -->
                <LinearLayout
                    android:id="@+id/ll_hidden_apps"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_hidden" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/hidden_apps" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Page Transition -->
                <LinearLayout
                    android:id="@+id/ll_page_transition"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_transition" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/page_transition" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- App Library -->
                <LinearLayout
                    android:id="@+id/ll_app_library"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_library" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/app_library" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Change App Name -->
                <LinearLayout
                    android:id="@+id/ll_change_app_name"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_app_name" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/change_app_name" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Badge Notifications -->
                <LinearLayout
                    android:id="@+id/ll_badge_notifications"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_badge" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/badge_notifications" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Language -->
                <LinearLayout
                    android:id="@+id/ll_language"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_language" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/language" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Appearance -->
                <LinearLayout
                    android:id="@+id/ll_appearance"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_appearance" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/appearance" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Select Default Launcher -->
                <LinearLayout
                    android:id="@+id/ll_select_default"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_select_default" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/select_default_launcher" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

            </LinearLayout>

            <!-- ===================== App Function Settings (tạm ẩn) ===================== -->
            <TextView
                android:id="@+id/tv_app_function_label"
                style="@style/HomeGroupLabel"
                android:text="@string/app_function_settings"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_app_function_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lang_card"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Launcher AI -->
                <LinearLayout
                    android:id="@+id/ll_launcher_ai"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_ai" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/launcher_ai" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Weather -->
                <LinearLayout
                    android:id="@+id/ll_weather"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_weather" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/weather" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

            </LinearLayout>

            <!-- ===================== Other ===================== -->
            <TextView
                style="@style/HomeGroupLabel"
                android:text="@string/other" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lang_card"
                android:orientation="vertical">

                <!-- Rate Our App -->
                <LinearLayout
                    android:id="@+id/ll_rate"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_rate" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/rate_our_app" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Mail To Us -->
                <LinearLayout
                    android:id="@+id/ll_mail"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_mail" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/mail_to_us" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

                <View style="@style/HomeSettingDivider" />

                <!-- Privacy Policy -->
                <LinearLayout
                    android:id="@+id/ll_privacy"
                    style="@style/HomeSettingRow">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/HomeSettingIcon"
                        android:src="@drawable/ic_home_privacy" />

                    <TextView
                        style="@style/HomeSettingLabel"
                        android:text="@string/privacy_policy" />

                    <ImageView style="@style/HomeSettingArrow" />
                </LinearLayout>

            </LinearLayout>

            <!-- ===================== Device ID ===================== -->
            <TextView
                style="@style/HomeGroupLabel"
                android:text="@string/device_id" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_lang_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tv_device_id"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_medium"
                    android:maxLines="1"
                    android:textColor="@color/onb_accent"
                    android:textSize="16sp"
                    tools:text="70d277738cacf2a53a5080d3abe02cae" />

                <ImageView
                    android:id="@+id/iv_copy_device_id"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_home_copy" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
