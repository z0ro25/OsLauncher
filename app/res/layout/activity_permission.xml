<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onb_bg"
    android:fitsSystemWindows="true">

    <!-- ===== Illustration team-building (đổi theo theme qua -night) ===== -->
    <ImageView
        android:id="@+id/iv_illustration"
        android:layout_width="247dp"
        android:layout_height="228dp"
        android:layout_marginTop="40dp"
        android:contentDescription="@null"
        android:src="@drawable/perm_illustration"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===== Tiêu đề ===== -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/sf_pro_display_semibold"
        android:gravity="center"
        android:text="@string/permission_required"
        android:textColor="@color/onb_text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_illustration" />

    <!-- ===== Mô tả ===== -->
    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/sf_pro_display_regular"
        android:gravity="center"
        android:text="@string/permission_desc"
        android:textColor="@color/onb_text_primary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />

    <!-- ===== Card 2 dòng quyền ===== -->
    <LinearLayout
        android:id="@+id/card_permissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/perm_card_bg"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc">

        <!-- Dòng External Storage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/sf_pro_display_regular"
                android:text="@string/external_storage"
                android:textColor="@color/onb_text_primary"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/sw_external"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumb="@drawable/perm_sw_thumb"
                android:track="@drawable/perm_sw_track" />
        </LinearLayout>

        <!-- Divider 0.5px (Figma) giữa 2 dòng -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/onb_divider" />

        <!-- Dòng Notification -->
        <LinearLayout
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/sf_pro_display_regular"
                android:text="@string/notification"
                android:textColor="@color/onb_text_primary"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/sw_notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumb="@drawable/perm_sw_thumb"
                android:track="@drawable/perm_sw_track" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Nút Complete (bo tròn xanh, full-width) ===== -->
    <TextView
        android:id="@+id/btn_complete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/sf_pro_display_medium"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/complete"
        android:textColor="@color/color.007AFF"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_permissions" />

    <FrameLayout
        android:id="@+id/fr_native"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_c16_fff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include layout="@layout/fsd_ads_shimmer_small"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
