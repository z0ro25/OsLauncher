<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onb_intro_bg">

    <!-- Ảnh chỉ trải quá mép trên thẻ chữ 16dp (thẻ bo góc đè đúng mép ảnh như Figma).
         Trang native_full ẩn ll_content → goneMarginTop=0 cho pager phủ tới đáy như cũ. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/space_pager_end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Space
        android:id="@+id/space_pager_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="@id/ll_content"
        app:layout_goneMarginTop="0dp" />

    <ImageView
        android:visibility="gone"
        android:id="@+id/ic_close"
        android:layout_width="32sp"
        android:layout_height="32sp"
        android:src="@drawable/ic_x_round"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_onb_intro_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="20dp"
        app:layout_constraintBottom_toTopOf="@id/fr_native"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/onb_intro_title"
            android:textSize="24sp"
            tools:text="Experience IOS 26 with a futuristic look" />

        <TextView
            android:id="@+id/tv_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/sf_pro_display_medium"
            android:gravity="center"
            android:textColor="@color/onb_intro_title"
            android:textSize="16sp"
            tools:text="Every choice carves a new path. Take control of your own interactive saga." />

        <RelativeLayout
            android:id="@+id/rl_nav"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="20dp">

            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/dotindicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:dotsColor="@color/onb_intro_dot"
                app:dotsCornerRadius="4dp"
                app:dotsSize="8dp"
                app:dotsSpacing="1.5dp"
                app:dotsWidthFactor="2.5"
                app:selectedDotColor="@color/color.007AFF" />

            <TextView
                android:id="@+id/tv_continue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:includeFontPadding="false"
                android:text="@string/continue_"
                android:textColor="@color/color.007AFF"
                android:textSize="16sp" />

        </RelativeLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/fr_native"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/onb_intro_card"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
