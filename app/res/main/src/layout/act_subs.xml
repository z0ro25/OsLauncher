<?xml version="1.0" encoding="utf-8"?>
<!-- Màn Subs (Figma IAP/theme 983:59839). Nền + hero + badge PRO là ảnh export. Không cuộn: nội dung neo
     đáy, màn ngắn thì đè lên đáy hero để gói + Continue luôn hiện đủ. Giữ id cũ (ic_x, view_year...) cho SubsAct. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF3FC">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_iap_theme" />

    <!-- Hero full size, neo đỉnh. Cụm nội dung + Continue neo đáy; màn cao thì nội dung kéo lên sát hero,
         màn ngắn thì đè lên đáy hero (vốn đã mờ dần). Vị trí do SubsAct.placeContent() đặt. -->
    <ImageView
        android:id="@+id/img_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/img_iap_hero" />

    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:includeFontPadding="false"
                        android:text="MiOS Launcher"
                        android:textColor="#151515"
                        android:textSize="30sp" />

                    <!-- Ảnh badge có chừa lề 14dp mỗi cạnh cho bóng/tia sáng -> lề âm để thân badge
                         cách chữ 12dp như Figma. -->
                    <ImageView
                        android:layout_width="110dp"
                        android:layout_height="73dp"
                        android:layout_marginStart="-2dp"
                        android:layout_marginVertical="-17dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/img_iap_pro_badge" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/quicksand_semibold"
                    android:alpha="0.7"
                    android:text="@string/subs_start_premium"
                    android:textColor="#151515"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp">

                    <TextView
                        style="@style/SubsFeature"
                        android:drawableStart="@drawable/ic_iap_feature_theme"
                        android:text="@string/subs_feature_themes" />

                    <TextView
                        style="@style/SubsFeature"
                        android:drawableStart="@drawable/ic_iap_feature_wallpaper"
                        android:text="@string/subs_feature_wallpapers" />

                    <TextView
                        style="@style/SubsFeature"
                        android:drawableStart="@drawable/ic_iap_feature_icon"
                        android:text="@string/subs_feature_icons" />

                    <TextView
                        style="@style/SubsFeature"
                        android:drawableStart="@drawable/ic_iap_feature_adfree"
                        android:text="@string/subs_feature_ad_free" />
                </LinearLayout>

                <!-- 2 thẻ gói: chừa 11dp trên cho tag BEST VALUE, 12dp dưới cho bóng. Cao / nền / màu giá theo
                     thẻ đang chọn do SubsAct.renderPlans() đặt (Figma có 2 frame chọn Yearly / Monthly). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:baselineAligned="false"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="11dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:id="@+id/view_year"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_iap_plan_selected"
                        android:clipChildren="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="22dp"
                            android:paddingBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/quicksand_semibold"
                                android:text="@string/yearly"
                                android:textColor="#151515"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tv_year_prices"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/quicksand_bold"
                                android:maxLines="1"
                                android:textColor="#2563EB"
                                android:textSize="24sp"
                                android:text="@string/subs_price_year_fallback" />

                            <TextView
                                android:id="@+id/tv_year_per_month"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/quicksand_medium"
                                android:textColor="#6B7280"
                                android:textSize="12sp"
                                tools:text="≈ 133.000₫ / month" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tv_year_trial"
                                style="@style/SubsTrialPill"
                                android:background="@drawable/bg_iap_trial_selected"
                                android:textColor="#15803D"
                                android:visibility="gone"
                                tools:text="3-day free trial"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ic_dot_year"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="22dp"
                            android:layout_marginEnd="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_iap_radio_on" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="-11dp"
                            android:background="@drawable/bg_iap_best_value"
                            android:drawableStart="@drawable/ic_iap_star"
                            android:drawablePadding="4dp"
                            android:fontFamily="@font/quicksand_bold"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:text="@string/subs_best_value"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/view_month"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_iap_plan_normal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/quicksand_semibold"
                                android:text="@string/monthly"
                                android:textColor="#151515"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tv_month_prices"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/quicksand_bold"
                                android:maxLines="1"
                                android:textColor="#1F2937"
                                android:textSize="21sp"
                                android:text="@string/subs_price_month_fallback" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/quicksand_medium"
                                android:text="@string/subs_billed_monthly"
                                android:textColor="#6B7280"
                                android:textSize="12sp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tv_month_trial"
                                style="@style/SubsTrialPill"
                                android:background="@drawable/bg_iap_trial_normal"
                                android:textColor="#475569"
                                android:visibility="gone"
                                tools:text="3-day free trial"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ic_dot_month"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_iap_radio_off" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

        <!-- Khoảng giãn giữa gói và Continue ở màn cao (Figma: nội dung sát hero, Continue ghim đáy). -->
        <Space
            android:id="@+id/space_gap"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/btn_continue"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_iap_continue"
                android:fontFamily="@font/quicksand_semibold"
                android:gravity="center"
                android:text="@string/continue_"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_then_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/quicksand_medium"
                android:gravity="center"
                android:text="@string/cancel_anytime"
                android:textColor="#363638"
                android:textSize="12sp"
                tools:text="Then 1.600.000₫/year. • Cancel anytime" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="24dp">

                <TextView
                    android:id="@+id/tv_tc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:fontFamily="@font/quicksand_medium"
                    android:text="@string/t_c"
                    android:textColor="#363638"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/quicksand_medium"
                    android:text="@string/privacy_policy_u"
                    android:textColor="#363638"
                    android:textSize="12sp" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Thanh trên đè lên hero: X (hiện sau 3s, xem SubsAct) + Restore. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="35dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ic_x"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/subs_offer_close"
            android:src="@drawable/ic_close_subs"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_restore"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_iap_restore"
            android:drawableStart="@drawable/ic_restore_subs"
            android:drawablePadding="4dp"
            android:fontFamily="@font/quicksand_semibold"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/restore"
            android:textColor="#1C1C1E"
            android:textSize="12sp" />
    </FrameLayout>
</FrameLayout>
