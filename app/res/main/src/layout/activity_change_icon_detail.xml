<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn đổi icon chi tiết dựng theo Figma (dark 27-635 / light node tương ứng): header (back glass +
  title = tên app + link "Reset" góc phải) + card (icon 64dp + tên app + nút xanh "Choose from Gallery").

  Theo scope đã chốt: CHỈ Choose from Gallery + Reset (BỎ phần icon packs Default/Dark/Clear light).

  Scope no side-effects: token onb_* + resource RIÊNG changeicon_card_bg / changeicon_back_bg /
  changeicon_ic_chevron_back / changeicon_btn_gallery. Giữ id: iv_back, tv_title, tv_reset,
  iv_app_icon, tv_app_label, btn_gallery.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onb_bg"
    android:fitsSystemWindows="true">

    <!-- ===== Header: nút back tròn glass ===== -->
    <FrameLayout
        android:id="@+id/iv_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/changeicon_back_bg"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/changeicon_ic_chevron_back" />
    </FrameLayout>

    <!-- Title = tên app (custom nếu đã đổi, ngược lại nhãn gốc) -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="72dp"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/sf_pro_display_semibold"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/change_app_icon"
        android:textColor="@color/onb_text_primary"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Link "Reset" góc phải header -> đưa icon về mặc định hệ thống -->
    <TextView
        android:id="@+id/tv_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:padding="8dp"
        android:fontFamily="@font/sf_pro_display_regular"
        android:text="@string/reset"
        android:textColor="@color/onb_accent"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title" />

    <!-- ===== Card: icon lớn + tên + nút Choose from Gallery ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/changeicon_card_bg"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">

        <ImageView
            android:id="@+id/iv_app_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_app_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/sf_pro_display_regular"
            android:gravity="center"
            android:maxLines="1"
            android:text="Chrome"
            android:textColor="@color/onb_text_primary"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_app_icon" />

        <TextView
            android:id="@+id/btn_gallery"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/changeicon_btn_gallery"
            android:fontFamily="@font/sf_pro_display_medium"
            android:gravity="center"
            android:text="@string/choose_from_gallery"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_app_label" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
