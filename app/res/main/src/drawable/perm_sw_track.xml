<?xml version="1.0" encoding="utf-8"?>
<!-- Track switch kiểu iOS màn Permission: bật = xanh #34C759 (Figma accents/green), tắt = token
     2-theme onb_switch_track_off. RIÊNG màn này (không mượn general_sw_*). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="51dp" android:height="31dp" />
            <corners android:radius="100dp" />
            <solid android:color="#34C759" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="51dp" android:height="31dp" />
            <corners android:radius="100dp" />
            <solid android:color="@color/onb_switch_track_off" />
        </shape>
    </item>
</selector>
