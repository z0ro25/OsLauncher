<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dòng tính năng màn Subs: icon 24dp (ảnh 32x34dp gồm lề bóng) + chữ cách icon 10dp. -->
    <style name="SubsFeature">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">-4dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:fontFamily">@font/quicksand_semibold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#151515</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SubsTrialPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:fontFamily">@font/quicksand_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
