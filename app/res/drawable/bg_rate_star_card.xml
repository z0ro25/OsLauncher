<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ trắng (dark: #1C1C1E) bọc cụm 5 sao + dòng "The best rating star".
     Dark mode có thêm viền mảnh cho thẻ tách khỏi nền đen (theo ảnh thiết kế). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/onb_card" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/rate_star_card_stroke" />
</shape>
