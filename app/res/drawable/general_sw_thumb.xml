<?xml version="1.0" encoding="utf-8"?>
<!-- Thumb switch kiểu iOS màn General. Trắng, đường kính 31dp = chiều cao track -> tròn đều,
     không bị SwitchCompat kéo giãn. Stroke 4dp trong suốt tạo khoảng cách đều với lề track. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <size
        android:width="31dp"
        android:height="31dp" />
    <solid android:color="#FFFFFF" />
    <stroke
        android:width="4dp"
        android:color="@android:color/transparent" />
</shape>
